{
  "ci": {
    "collect": {
      "startServerCommand": "npx astro preview --port 4321 --host localhost --ignore-lock",
      "startServerReadyPattern": "localhost:4321",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/product/",
        "http://localhost:4321/he/",
        "http://localhost:4321/he/product/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median-run" }
        ],
        "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:best-practices": [
          "error",
          { "minScore": 1, "aggregationMethod": "median-run" }
        ],
        "categories:seo": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 1800, "aggregationMethod": "median-run" }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.02, "aggregationMethod": "median-run" }
        ],
        "total-blocking-time": [
          "error",
          { "maxNumericValue": 100, "aggregationMethod": "median-run" }
        ],
        "resource-summary:script:size": ["error", { "maxNumericValue": 25600 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 122880 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 204800 }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
