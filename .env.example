# Every variable is optional. Empty values keep the related feature switched off.

# Absolute origin the site is served from. Used for canonical URLs, hreflang,
# the sitemap and Open Graph tags. Default: http://localhost:4321
PUBLIC_SITE_URL=

# Address for the mailto: fallback, responsible disclosure and accessibility
# contact. While empty, those places show a visible TODO(operator) marker.
PUBLIC_CONTACT_EMAIL=

# Form endpoint (absolute https URL) that receives POSTs from the design-partner
# and contact forms. While empty, each form is replaced by a mailto: button.
# Its origin is added to the CSP form-action directive at build time.
PUBLIC_FORM_ENDPOINT=

# Public source repository. While empty, no GitHub link is rendered.
PUBLIC_GITHUB_URL=

# Public documentation. While empty, "Docs" is not rendered in the navigation.
PUBLIC_DOCS_URL=

# --- Docker (compose.yaml) ---------------------------------------------------
# Host port and bind address for the container (it listens on 8080 inside).
LANCOMPASS_WEB_PORT=8088
LANCOMPASS_WEB_BIND=0.0.0.0
# Image tag and OCI revision label.
LANCOMPASS_WEB_VERSION=0.1.0
LANCOMPASS_WEB_REVISION=unknown
