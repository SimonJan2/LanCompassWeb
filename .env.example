# Every variable is optional. Empty values keep the related feature switched off.

# Absolute origin the site is served from. Used for canonical URLs, hreflang,
# the sitemap and Open Graph tags. Default: http://localhost:4321
PUBLIC_SITE_URL=

# Address for the mailto: fallback, responsible disclosure and accessibility
# contact. While empty, those places show a visible TODO(operator) marker.
PUBLIC_CONTACT_EMAIL=

# Form endpoint (absolute https URL) that receives POSTs from the pilot application
# and contact forms. While empty, each form is replaced by a mailto: button.
# Its origin is added to the CSP form-action directive at build time.
PUBLIC_FORM_ENDPOINT=

# Public documentation. While empty, "Docs" is not rendered in the navigation.
PUBLIC_DOCS_URL=

# Colour theme, chosen at build time: light (survey paper), dark (Night chart) or auto (both
# palettes ship; each visitor's OS preference picks one, and a light/dark switch in the header
# lets a visitor choose the other — W13). auto is the published theme (DECISIONS.md D-THEME); an
# empty value builds light. Any other value fails the build. With Docker, rebuild after
# changing it (--build).
PUBLIC_SITE_THEME=auto

# Search engines: true (default) lets them index the site. false makes the build a preview:
# every response carries X-Robots-Tag: noindex and robots.txt lists no sitemap (crawlers may
# still fetch pages, so they can read the noindex). No HTML changes. Any other value fails the
# build. To leave preview: set PUBLIC_SITE_URL to the real domain, remove this line, rebuild,
# and redirect the preview address to the domain (docs/go-public.md).
PUBLIC_SITE_INDEXING=true

# --- Docker (compose.yaml) ---------------------------------------------------
# Host port and bind address for the container (it listens on 8080 inside).
LANCOMPASS_WEB_PORT=8088
LANCOMPASS_WEB_BIND=0.0.0.0
# Image tag and OCI revision label.
LANCOMPASS_WEB_VERSION=0.1.0
LANCOMPASS_WEB_REVISION=unknown
