---
import Icon, { type IconName } from "./Icon.astro";

/** A card with a line icon, a title and a short text. Hover lifts by 1px with a hairline glow. */
interface Props {
  icon?: IconName;
  title: string;
  text: string;
  class?: string;
  headingLevel?: 3 | 4;
}

const { icon, title, text, class: className, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 3 ? "h3" : "h4";
---

<article class:list={["card", className]}>
  {icon && (
    <span class="card-icon">
      <Icon name={icon} size={22} />
    </span>
  )}
  <Heading class="card-title" set:html={title} />
  <p class="card-text" set:html={text} />
  <slot />
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    block-size: 100%;
    padding: 1.5rem;
    border: 1px solid var(--lc-hairline);
    border-radius: var(--lc-radius);
    background: var(--lc-ink-card);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition:
        transform 200ms var(--lc-ease),
        border-color 200ms ease,
        box-shadow 200ms ease;
    }

    .card:hover {
      transform: translateY(-1px);
      border-color: rgba(52, 211, 153, 0.28);
      box-shadow: 0 0 0 1px rgba(52, 211, 153, 0.08);
    }
  }

  .card-icon {
    display: inline-grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    margin-block-end: 0.375rem;
    border: 1px solid var(--lc-hairline-strong);
    border-radius: 10px;
    color: var(--lc-signal-bright);
  }

  .card-title {
    font-size: var(--lc-text-h3);
    letter-spacing: -0.01em;
  }

  .card-text {
    color: var(--lc-text-muted);
    font-size: var(--lc-text-small);
    line-height: 1.6;
  }

  .card-text :global(code) {
    color: var(--lc-text);
  }
</style>
