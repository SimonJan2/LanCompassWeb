---
import Icon, { type IconName } from "./Icon.astro";

/** A plate: a ruled top edge, a line icon, a title and a short text. No box, no glow. */
interface Props {
  icon?: IconName;
  title: string;
  text: string;
  class?: string;
  headingLevel?: 3 | 4;
}

const { icon, title, text, class: className, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 3 ? "h3" : "h4";
---

<article class:list={["card", className]}>
  {icon && (
    <span class="card-icon">
      <Icon name={icon} size={22} />
    </span>
  )}
  <Heading class="card-title" set:html={title} />
  <p class="card-text" set:html={text} />
  <slot />
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    block-size: 100%;
    padding: 1.5rem 0 0;
    border-block-start: 1px solid var(--lc-ink);
  }

  .card-icon {
    display: inline-grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    margin-block-end: 0.25rem;
    border: 1px solid var(--lc-rule-strong);
    border-radius: 50%;
    color: var(--lc-ink);
  }

  .card-title {
    font-size: var(--lc-text-h3);
  }

  .card-text {
    color: var(--lc-ink-muted);
    font-size: var(--lc-text-small);
    line-height: 1.6;
  }

  .card-text :global(code) {
    color: var(--lc-ink);
  }
</style>
