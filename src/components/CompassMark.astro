---
/**
 * The LanCompass compass, inlined (no request). Never mirrored in RTL.
 * `heading` rotates the needle (degrees, clockwise) — the 404 page uses it.
 */
import { uid } from "../lib/uid";

interface Props {
  size?: number;
  class?: string;
  heading?: number;
  /** Accessible name; omit for a decorative mark. */
  label?: string;
  tile?: boolean;
}

const { size = 28, class: className = "", heading = 0, label, tile = false } = Astro.props;
const id = uid("sheen");
---

<svg
  class:list={["compass-mark", className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <defs>
    <linearGradient id={id} x1="16" y1="3.2" x2="16" y2="28.8" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#34d399"></stop>
      <stop offset="1" stop-color="#10b981" stop-opacity="0.4"></stop>
    </linearGradient>
  </defs>
  {tile && <rect width="32" height="32" rx="7" fill="#0c0d10" />}
  <circle cx="16" cy="16" r="12.55" fill="none" stroke={`url(#${id})`} stroke-width="1.5"></circle>
  <path d="M16 4.5v2.2" stroke="#34d399" stroke-width="1.6" stroke-linecap="round"></path>
  <path
    d="M27.5 16h-2 M16 27.5v-2 M4.5 16h2"
    stroke="#10b981"
    stroke-width="1.1"
    stroke-linecap="round"
    opacity="0.5"
  ></path>
  <g transform={heading ? `rotate(${heading} 16 16)` : undefined}>
    <path d="M16 7.1 L18 16.7 L16 15.2 L14 16.7 Z" fill="#f8fafc"></path>
    <path d="M16 24.9 L14 15.3 L16 16.8 L18 15.3 Z" fill="#10b981" opacity="0.65"></path>
  </g>
  <circle cx="16" cy="16" r="1.7" fill="#f8fafc"></circle>
</svg>
