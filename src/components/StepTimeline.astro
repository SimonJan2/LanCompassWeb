---
import ScreenshotFrame from "./ScreenshotFrame.astro";
import Icon from "./Icon.astro";
import type { Locale } from "../i18n";
import { isScreenKey } from "../lib/screens";

/**
 * The Document → Observe → Reconcile loop: three numbered steps set side by
 * side as columns, then one large screenshot for the idea as a whole.
 */
interface Props {
  locale: Locale;
  steps: { name: string; text: string; bullets: string[] }[];
  figure?: { screen: string; caption: string };
}

const { locale, steps, figure } = Astro.props;
---

<ol class="steps" role="list">
  {steps.map((step, index) => (
    <li class="step reveal">
      <p class="step-index" aria-hidden="true" dir="ltr">
        {String(index + 1).padStart(2, "0")}
        <span class="step-rule"></span>
      </p>
      <h3 class="step-name" set:html={step.name} />
      <p class="step-text" set:html={step.text} />
      <ul class="step-bullets" role="list">
        {step.bullets.map((b) => (
          <li>
            <Icon name="check" size={16} class="step-check" />
            <span set:html={b} />
          </li>
        ))}
      </ul>
    </li>
  ))}
</ol>
{figure && isScreenKey(figure.screen) && (
  <figure class="step-figure reveal">
    <ScreenshotFrame
      screen={figure.screen}
      locale={locale}
      crop="wide"
      sizes="(min-width: 1264px) 1200px, 100vw"
    />
    <figcaption class="step-caption" set:html={figure.caption} />
  </figure>
)}

<style>
  .steps {
    display: grid;
    gap: 2.5rem;
    margin: clamp(3rem, 2rem + 3vw, 4.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .step-index {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-block-end: 1.25rem;
    color: var(--lc-ink);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-text-mono);
    font-weight: 500;
  }

  .step-rule {
    flex: 1;
    block-size: 1px;
    background: var(--lc-ink);
  }

  .step-name {
    font-size: clamp(1.625rem, 1.3rem + 1.2vw, 2.25rem);
  }

  .step-text {
    margin-block-start: 0.75rem;
    color: var(--lc-ink-muted);
  }

  .step-bullets {
    display: grid;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--lc-text-small);
  }

  .step-bullets li {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .step-bullets :global(.step-check) {
    flex: none;
    margin-block-start: 0.25rem;
    color: var(--lc-documented-line);
  }

  .step-figure {
    margin: clamp(3rem, 2rem + 3vw, 5rem) 0 0;
  }

  .step-caption {
    margin-block-start: 0.875rem;
    color: var(--lc-ink-muted);
    font-size: var(--lc-text-small);
  }
</style>
