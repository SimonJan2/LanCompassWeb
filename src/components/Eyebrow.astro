---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<p class:list={["eyebrow", className]}>
  <slot />
</p>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-block-end: 1.25rem;
    color: var(--lc-ink-muted);
    font-size: var(--lc-text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* A bearing tick, taken from the compass ring. */
  .eyebrow::before {
    content: "";
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border-block-start: 1px solid currentColor;
    border-inline-start: 1px solid currentColor;
  }

  :lang(he) .eyebrow {
    letter-spacing: 0;
    font-size: var(--lc-text-small);
  }
</style>
