---
/**
 * The compass mark on its own app-icon tile (the mark is unchanged from the
 * product, and its white north needle needs the dark tile on paper), beside
 * the wordmark "LanCompass" set in Plex Sans. Never mirrored.
 */
import CompassMark from "./CompassMark.astro";

interface Props {
  href: string;
  label: string;
  size?: number;
}

const { href, label, size = 28 } = Astro.props;
---

<a href={href} class="logo" aria-label={label}>
  <CompassMark size={size} tile />
  <span class="logo-word" translate="no" dir="ltr">
    LanCompass
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--lc-ink);
    text-decoration: none;
    border-radius: 2px;
  }

  .logo-word {
    font-family: var(--lc-font-sans);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    unicode-bidi: isolate;
  }
</style>
