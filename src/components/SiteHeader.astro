---
import Button from "./Button.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Logo from "./Logo.astro";
import MobileNav from "./MobileNav.astro";
import { site } from "../config/site";
import {
  pagePath,
  sectionPath,
  useUi,
  type Locale,
  type LocalePaths,
  type PageKey,
  type SectionKey,
} from "../i18n";

interface Props {
  locale: Locale;
  page: PageKey | SectionKey;
  /** A section page's twins (BaseLayout), for the language switcher. */
  paths?: LocalePaths | undefined;
}

const { locale, page, paths } = Astro.props;
const ui = useUi(locale);
/** W9: the docs live on the site (/docs/); PUBLIC_DOCS_URL, when set, still wins. */
const docsHref = sectionPath(locale, "docs");
const links: { page: PageKey; label: string }[] = [
  { page: "product", label: ui.nav.product },
  { page: "security", label: ui.nav.security },
  { page: "pilot", label: ui.nav.pilot },
];
---

<header class="site-header" data-site-header>
  <div class="container-site header-inner">
    <Logo href={pagePath(locale, "home")} label={ui.nav.home} />
    <nav class="header-nav" aria-label={ui.nav.label}>
      <ul role="list">
        {links.map((link) => (
          <li>
            <a
              href={pagePath(locale, link.page)}
              aria-current={link.page === page ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          {site.docsUrl ? (
            <a href={site.docsUrl} data-flag="docs">
              {ui.nav.docs}
            </a>
          ) : (
            <a href={docsHref} aria-current={page === "docs" ? "page" : undefined}>
              {ui.nav.docs}
            </a>
          )}
        </li>
      </ul>
    </nav>
    <div class="header-actions">
      <LanguageSwitcher locale={locale} page={page} paths={paths} />
      <Button href={`${pagePath(locale, "pilot")}#apply`} class="header-cta">
        {ui.nav.cta}
      </Button>
      <MobileNav locale={locale} page={page} paths={paths} links={links} />
    </div>
  </div>
</header>

<style is:global>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    border-block-end: 1px solid transparent;
    background: color-mix(in srgb, var(--lc-paper) 86%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .site-header[data-scrolled="true"] {
    border-block-end-color: var(--lc-rule);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      transition: border-color var(--lc-dur-ui) ease;
    }
  }

  .site-header .header-inner {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    min-block-size: 4.25rem;
  }

  .site-header .header-nav {
    flex: 1;
  }

  .site-header .header-nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header .header-nav a {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    color: var(--lc-ink-muted);
    font-size: var(--lc-text-small);
    font-weight: 500;
    text-decoration: none;
  }

  .site-header .header-nav a:hover,
  .site-header .header-nav a[aria-current="page"] {
    color: var(--lc-ink);
  }

  .site-header .header-nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 8px;
  }

  .site-header .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-header .header-actions .header-cta {
    min-block-size: 2.5rem;
    padding: 0.5rem 1rem;
    font-size: var(--lc-text-small);
  }

  @media (max-width: 959px) {
    .site-header .header-nav,
    .site-header .header-actions .header-cta,
    .site-header .header-actions > .lang-menu {
      display: none;
    }

    .site-header .header-inner {
      justify-content: space-between;
    }
  }
</style>
