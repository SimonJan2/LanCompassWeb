---
/**
 * /security#verification: the active signing keys of src/content/fingerprints.json (the release
 * key, W6), each with its purpose and SHA-256 fingerprint, and a link to /verify/, where the
 * three checks and the key history are. Renders nothing while the file is empty.
 */
import { pagePath, useUi, type Locale } from "../i18n";
import { getFingerprints } from "../lib/fingerprints";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = useUi(locale).verification;
const keys = getFingerprints().filter((key) => key.lastRelease === null);
---

{keys.length > 0 && (
  <section
    id="verification"
    class="verification"
    aria-labelledby="verification-title"
    data-fingerprints
  >
    <h2 id="verification-title">{ui.title}</h2>
    <p class="verification-lead" set:html={ui.lead} />
    {keys.map((key) => (
      <dl class="verification-key" id={`key-${key.id}`}>
        <div>
          <dt>{ui.kid}</dt>
          <dd>
            {key.label[locale]}
            {key.kid && (
              <>
                {" "}
                <code dir="ltr">{key.kid}</code>
              </>
            )}
          </dd>
        </div>
        <div>
          <dt>{ui.purpose}</dt>
          <dd>{key.purpose[locale]}</dd>
        </div>
        <div>
          <dt set:html={ui.sha256} />
          <dd>
            <code class="fp" dir="ltr" data-fingerprint={key.id}>
              {key.sha256}
            </code>
          </dd>
        </div>
      </dl>
    ))}
    <p class="verification-link">
      <a href={`${pagePath(locale, "verify")}#check`}>{ui.link}</a>
    </p>
  </section>
)}

<style>
  .verification {
    max-inline-size: 56rem;
    padding: 2rem;
    border: 1px solid var(--lc-ink);
    background: var(--lc-paper-raised);
  }

  .verification h2 {
    font-size: 1.5rem;
  }

  .verification-lead {
    margin-block: 0.75rem 1.5rem;
    color: var(--lc-ink-muted);
  }

  .verification-key {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    font-size: var(--lc-text-small);
  }

  .verification-key dt {
    color: var(--lc-ink-faint);
    font-weight: 600;
  }

  .verification-key dd {
    margin: 0.125rem 0 0;
    color: var(--lc-ink);
  }

  .fp {
    overflow-wrap: anywhere;
  }

  .verification-link {
    margin-block-start: 1.25rem;
  }

  .verification-link a {
    color: var(--lc-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
