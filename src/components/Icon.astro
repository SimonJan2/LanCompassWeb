---
/**
 * The site's own line icons: 24px grid, 1.5px stroke, round caps, currentColor.
 * Directional icons (arrows, chevrons pointing inline) mirror in RTL.
 * An icon is a <use> of its <symbol> in /icons.svg (src/lib/icon-paths.ts), so a page carries
 * no repeated coordinates (W2: the home page's first round trip). Icons that render before the
 * page's first paint (the header's, the buttons') are drawn `inline` instead. Any <use> on a
 * page makes the browser fetch /icons.svg while the HTML parses (content-visibility does not
 * defer it), so a page whose LCP cannot take that request sets Astro.locals.inlineIcons and
 * draws them all inline (the English home). The fixed width and height keep the layout still.
 */
import { iconPaths, type IconName } from "../lib/icon-paths";
export type { IconName } from "../lib/icon-paths";

interface Props {
  name: IconName;
  size?: number;
  /** Draw the paths in the page: for icons above the fold (header, buttons). */
  inline?: boolean;
  class?: string;
}

const { name, size = 24, class: className = "" } = Astro.props;
/** A page may ask for every icon inline (Astro.locals.inlineIcons: the English home's LCP). */
const inline = Astro.props.inline || Astro.locals.inlineIcons === true;
const directional = new Set<IconName>(["arrow"]);
const classes = ["icon", directional.has(name) ? "rtl-flip" : "", className]
  .filter(Boolean)
  .join(" ");
---

{inline ? (
  <svg
    class={classes}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    aria-hidden="true"
    data-icon={name}
    set:html={iconPaths[name]}
  />
) : (
  <svg class={classes} width={size} height={size} aria-hidden="true" data-icon={name}>
    <use href={`/icons.svg#${name}`} />
  </svg>
)}
