---
/**
 * W4: a product screen as a numbered figure; since W11 a crop of the figure's slot around the
 * thing its caption names (ScreenshotFrame, slot "figure": the desktop crop, and a phone crop
 * below the breakpoint). Up to four numbered marks sit on it, placed only from the capture's
 * anchors (src/content/screen-anchors.json) for the build's set, the screen's locale and the
 * picture the window shows — the desktop crop's positions inside a min-width media query, the
 * phone crop's inside a max-width one (the generated stylesheet) — as percentages of the
 * picture, so they scale. A numbered legend (ol) carries every note as text at every width; a
 * note whose thing lies outside a crop has no mark at that width (W11: the mark goes, never the
 * note). Each mark is an in-page link to its legend item (#fig-<n>-<m>), which :target
 * highlights. No JavaScript.
 *
 * A key, set or locale without anchors renders no marks and keeps its caption and legend
 * (lib/annotations). Every cropped figure links to its full window, a same-origin image (no
 * lightbox script).
 */
import ScreenshotFrame from "./ScreenshotFrame.astro";
import anchorData from "../content/screen-anchors.json";
import { fill, useUi, type Locale } from "../i18n";
import { site } from "../config/site";
import { figureNotes, markClass, MARKED_PICTURES, type AnchorFile } from "../lib/annotations";
// Each mark's position, as rules in this page's stylesheet (astro.config.mjs → figureMarksCss):
// the CSP blocks style attributes.
import "virtual:lancompass/figure-marks.css";
import { fullWindow, screenSets, slotPictures, type ScreenKey } from "../lib/screens";

interface Props {
  screen: ScreenKey;
  /** The page's locale; the screen is captured in the same one. */
  locale: Locale;
  /** The figure's number on its page: "Fig. n", and the ids #fig-<n> and #fig-<n>-<m>. */
  n: number;
  /** The caption after "Fig. n —" (inline HTML from the copy files). */
  caption: string;
  /** The notes, keyed by the anchor names the capture records; every note is in the legend. */
  notes: Record<string, string>;
  eager?: boolean;
  class?: string;
}

const { screen, locale, n, caption, notes, eager = false, class: className } = Astro.props;
const ui = useUi(locale);
const sets = screenSets(site.theme);
const picture = slotPictures("figure", sets[0]!, locale, screen).desktop;
/** No legend on a placeholder frame (no capture yet), as before W11. */
const items = picture ? figureNotes(anchorData as AnchorFile, { sets, locale, screen, notes }) : [];
const marked = items.filter((it) => Object.keys(it.marks).length > 0);
/** A mark's classes: its position in each picture, or `<prefix>-0` (no mark at that width). */
const classes = (it: (typeof items)[number]) =>
  MARKED_PICTURES.map(({ picture: p, prefix }) => {
    const m = it.marks[p as keyof typeof it.marks];
    return m ? markClass(m, prefix) : `${prefix}-0`;
  }).join(" ");
/** Every figure is a crop: it links to the whole window, one link per set (auto shows the
 *  scheme's own). */
const fullLinks = picture
  ? sets
      .map((set) => ({ set, href: fullWindow(set, locale, screen)?.src }))
      .filter((l): l is { set: typeof l.set; href: string } => !!l.href)
  : [];
const cropped = fullLinks.length > 0;
const label = fill(ui.figure.label, { n: String(n) });
---

<figure class:list={["fig", className]} id={`fig-${n}`} data-cropped={cropped ? "true" : undefined}>
  <ScreenshotFrame screen={screen} locale={locale} slot="figure" eager={eager}>
    {marked.length > 0 && (
      <div class="fig-layer">
        {items.map(
          (it, i) =>
            Object.keys(it.marks).length > 0 && (
              <span class={`fig-a ${classes(it)}`}>
                <a
                  href={`#fig-${n}-${i + 1}`}
                  aria-label={`${fill(ui.figure.note, { m: String(i + 1) })}: ${it.text.replace(/<[^>]+>/g, "")}`}
                >
                  {i + 1}
                </a>
              </span>
            ),
        )}
      </div>
    )}
  </ScreenshotFrame>
  {items.length > 0 && (
    <ol class="fig-notes" role="list">
      {items.map((it, i) => (
        <li id={`fig-${n}-${i + 1}`}>
          <span set:html={it.text} />
        </li>
      ))}
    </ol>
  )}
  <figcaption class="fig-caption">
    <span class="fig-no">{label}</span> — <span set:html={caption} />
    {fullLinks.map((l) => (
      <>
        {" "}
        <a class:list={["fig-full", fullLinks.length > 1 && `fig-full-${l.set}`]} href={l.href}>
          {ui.figure.full}
        </a>
      </>
    ))}
  </figcaption>
</figure>

<style is:global>
  /* The picture and the marks' layer share ScreenshotFrame's .shot-pic box, with no line gap
     under the image, so the layer covers exactly the picture in every theme's frame. */
  .fig .shot-pic {
    position: relative;
  }

  .fig .shot-pic .shot-img {
    display: block;
  }

  .fig .fig-layer {
    position: absolute;
    inset: 0;
  }

  /* One mark: a frame around the anchor W3 recorded, and the numbered link on its starting
     corner (the screen's own direction), kept inside the picture at every size. */
  .fig .fig-a {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .fig .fig-a::before {
    position: absolute;
    inset-block-start: var(--y);
    left: var(--x);
    inline-size: var(--w);
    block-size: var(--h);
    border: 2px solid var(--lc-action);
    border-radius: var(--lc-radius-sm);
    content: "";
  }

  .fig .fig-a a {
    position: absolute;
    top: clamp(14px, var(--y), calc(100% - 14px));
    left: clamp(14px, var(--x), calc(100% - 14px));
    display: grid;
    place-items: center;
    inline-size: 28px;
    block-size: 28px;
    border: 2px solid var(--lc-paper-raised);
    border-radius: 50%;
    background: var(--lc-action);
    color: var(--lc-action-text);
    font-family: var(--lc-font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    translate: -50% -50%;
    pointer-events: auto;
  }

  /* A right-to-left screen (the page's own locale) starts on the frame's right-hand corner. */
  [dir="rtl"] .fig .fig-a a {
    left: clamp(14px, calc(var(--x) + var(--w)), calc(100% - 14px));
  }

  .fig .fig-a a:hover {
    background: var(--lc-action-hover);
  }

  .fig .fig-a a:focus-visible {
    outline: 3px solid var(--lc-focus);
    outline-offset: 2px;
  }

  /* The legend: the same numbers, as text. The targeted note is lit. */
  .fig .fig-notes {
    display: grid;
    gap: 0.5rem 1.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: fig-note;
    font-size: var(--lc-text-small);
  }

  @media (min-width: 720px) {
    .fig .fig-notes {
      grid-template-columns: 1fr 1fr;
    }
  }

  .fig .fig-notes li {
    display: flex;
    gap: 0.625rem;
    padding: 0.25rem 0.375rem;
    border-radius: var(--lc-radius-sm);
    counter-increment: fig-note;
    scroll-margin-block: 9rem 2rem;
  }

  .fig .fig-notes li::before {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border-radius: 50%;
    background: var(--lc-action);
    color: var(--lc-action-text);
    content: counter(fig-note);
    font-family: var(--lc-font-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .fig .fig-notes li:target {
    background: var(--lc-observed-wash);
    color: var(--lc-ink);
  }

  .fig .fig-caption {
    margin-block-start: 0.75rem;
    color: var(--lc-ink-muted);
    font-size: var(--lc-text-small);
  }

  .fig .fig-no {
    color: var(--lc-ink);
    font-weight: 600;
  }

  /* auto: the full window of the page's own set — the rules live in src/styles/auto.css (W13),
     which an auto build alone carries, keyed on the system's scheme or the visitor's override. */

  /* W13 (D-SHOWCASE C): "Survey | Night chart" on the frame's bar, at its right end in both
     languages (the window's dots are at its left whatever the direction), put there by /product's
     script (src/scripts/showcase.ts) — so it is never shown without JavaScript — and sized to
     the bar: each choice at least 24 × 24 px. */
  .fig .shot {
    position: relative;
  }

  .fig .fig-sets {
    position: absolute;
    top: 2px;
    right: 0.375rem;
    display: flex;
    gap: 0.25rem;
  }

  /* W14: where a figure's bar is narrow (a phone, a narrow tablet), the window's name
     (ScreenshotFrame.astro) follows the dots, so it stays clear of the control at the right end;
     on the narrowest phones, where the two would meet, the control keeps the bar alone. */
  @media (max-width: 959px) {
    .fig .shot .shot-bar::after {
      padding-inline: 60px 0;
      text-align: left;
    }
  }

  @media (max-width: 379px) {
    .fig .shot .shot-bar::after {
      display: none;
    }
  }

  .fig .fig-sets button {
    min-block-size: 1.5rem;
    min-inline-size: 1.5rem;
    padding: 0 0.5rem;
    border: 1px solid transparent;
    border-radius: var(--lc-radius-sm);
    background: transparent;
    color: var(--lc-ink-muted);
    font: inherit;
    font-size: var(--lc-text-xs);
    line-height: 1;
    cursor: pointer;
  }

  .fig .fig-sets button:hover {
    color: var(--lc-ink);
  }

  .fig .fig-sets button[aria-pressed="true"] {
    border-color: var(--lc-ink);
    color: var(--lc-ink);
  }

  /* The frame clips what overflows it: the focus ring stays inside the button. */
  .fig .fig-sets button:focus-visible {
    outline-offset: -2px;
  }
</style>
