---
/**
 * A product screenshot in a device-less window frame drawn in CSS. Serves the
 * capture from src/assets/screens/<locale>/<screen>.png through Astro's image
 * pipeline (AVIF + WebP, srcset, explicit size). While a capture is missing it
 * renders a schematic placeholder of the same 16:10 shape. Screenshots are never
 * mirrored: the frame takes the screenshot's own direction.
 */
import { Picture } from "astro:assets";
import { fill, locales, useUi, type Locale } from "../i18n";
import { findScreen, type ScreenKey } from "../lib/screens";

interface Props {
  screen: ScreenKey;
  /** Locale of the page (alt text language). */
  locale: Locale;
  /** Locale of the screenshot itself; defaults to the page locale. */
  screenLocale?: Locale;
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const {
  screen,
  locale,
  screenLocale = locale,
  sizes = "(min-width: 1200px) 640px, (min-width: 768px) 50vw, 100vw",
  eager = false,
  class: className,
} = Astro.props;
const ui = useUi(locale);
const name = ui.screenshot.screens[screen];
const image = findScreen(screenLocale, screen);
const pattern =
  screen === "rack"
    ? "rack"
    : screen === "topology-observed"
      ? "graph"
      : screen === "dashboard"
        ? "cards"
        : "table";
const screenDir = locales[screenLocale].dir;
const plainName = name.replace(/<[^>]+>/g, "");
---

<div class:list={["shot", className]} data-screen={screen} data-captured={image ? "true" : "false"}>
  <div class="shot-bar" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>
  {image ? (
    <Picture
      src={image}
      formats={["avif", "webp"]}
      widths={[480, 800, 1200, 1600, image.width].filter((w) => w <= image.width)}
      sizes={sizes}
      alt={fill(ui.screenshot.alt, { screen: plainName })}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class="shot-img"
    />
  ) : (
    <div
      class:list={["shot-placeholder", `pattern-${pattern}`]}
      dir={screenDir}
      role="img"
      aria-label={fill(ui.screenshot.placeholder, { screen: plainName })}
    >
      <div class="ph-side">
        <span class="ph-logo" />
        {Array.from({ length: 7 }, (_, i) => (
          <span class:list={["ph-nav", i === 2 && "is-active"]} />
        ))}
      </div>
      <div class="ph-main">
        <div class="ph-top">
          <span class="ph-title" />
          <span class="ph-btn" />
        </div>
        {pattern === "table" &&
          Array.from({ length: 8 }, (_, i) => (
            <div class="ph-row">
              <span class="ph-cell w-30" />
              <span class="ph-cell w-20" />
              <span class:list={["ph-pill", i === 3 && "is-drift", i === 5 && "is-ok"]} />
              <span class="ph-cell w-15" />
            </div>
          ))}
        {pattern === "cards" && (
          <div class="ph-cards">
            {Array.from({ length: 6 }, (_, i) => (
              <div class:list={["ph-card", i === 0 && "is-wide"]}>
                <span class="ph-cell w-40" />
                <span class="ph-spark" />
              </div>
            ))}
          </div>
        )}
        {pattern === "rack" && (
          <div class="ph-racks">
            {Array.from({ length: 3 }, () => (
              <div class="ph-rack">
                {Array.from({ length: 10 }, (_, i) => (
                  <span
                    class:list={["ph-unit", i % 3 === 0 && "is-filled", i === 4 && "is-tall"]}
                  />
                ))}
              </div>
            ))}
          </div>
        )}
        {pattern === "graph" && (
          <svg class="ph-graph" viewBox="0 0 400 220" aria-hidden="true">
            <path d="M60 50L200 40L340 60M60 50L120 160M200 40L210 170M340 60L300 170M120 160L210 170" />
            <path class="ph-graph-obs" d="M300 170L360 190M210 170L300 170" />
            {[
              [60, 50],
              [200, 40],
              [340, 60],
              [120, 160],
              [210, 170],
              [300, 170],
              [360, 190],
            ].map(([x, y]) => (
              <rect x={(x ?? 0) - 18} y={(y ?? 0) - 9} width="36" height="18" rx="5" />
            ))}
          </svg>
        )}
      </div>
      <span class="ph-caption" set:html={name} />
    </div>
  )}
</div>

<style>
  .shot {
    overflow: hidden;
    border: 1px solid var(--lc-hairline-strong);
    border-radius: 12px;
    background: #0e1115;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 24px 60px -30px rgba(0, 0, 0, 0.75);
  }

  :global(.surface-paper) .shot {
    border-color: rgba(11, 13, 16, 0.16);
    box-shadow: 0 24px 50px -30px rgba(11, 13, 16, 0.45);
  }

  .shot-bar {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    border-block-end: 1px solid rgba(255, 255, 255, 0.06);
    background: #12161b;
    direction: ltr;
  }

  .shot-bar span {
    inline-size: 9px;
    block-size: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
  }

  .shot-img {
    inline-size: 100%;
    block-size: auto;
  }

  .shot :global(picture) {
    display: block;
  }

  .shot-placeholder {
    position: relative;
    display: grid;
    grid-template-columns: 15% 1fr;
    aspect-ratio: 16 / 10;
    background: #0e1115;
  }

  .ph-side {
    display: flex;
    flex-direction: column;
    gap: 9%;
    padding: 6% 12%;
    border-inline-end: 1px solid rgba(255, 255, 255, 0.06);
    background: #0b0e12;
  }

  .ph-logo {
    inline-size: 60%;
    block-size: 6%;
    border-radius: 4px;
    background: rgba(52, 211, 153, 0.45);
  }

  .ph-nav {
    block-size: 3.5%;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.08);
  }

  .ph-nav.is-active {
    background: rgba(16, 185, 129, 0.4);
  }

  .ph-main {
    display: flex;
    flex-direction: column;
    gap: 3.5%;
    padding: 4% 5%;
    min-inline-size: 0;
  }

  .ph-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    block-size: 8%;
  }

  .ph-title {
    inline-size: 32%;
    block-size: 55%;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.16);
  }

  .ph-btn {
    inline-size: 14%;
    block-size: 70%;
    border-radius: 5px;
    background: rgba(16, 185, 129, 0.55);
  }

  .ph-row {
    display: flex;
    align-items: center;
    gap: 4%;
    block-size: 6.5%;
    padding-inline: 2%;
    border-block-end: 1px solid rgba(255, 255, 255, 0.05);
  }

  .ph-cell {
    block-size: 38%;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.1);
  }

  .w-15 {
    inline-size: 15%;
  }
  .w-20 {
    inline-size: 20%;
  }
  .w-30 {
    inline-size: 30%;
  }
  .w-40 {
    inline-size: 40%;
  }

  .ph-pill {
    inline-size: 11%;
    block-size: 50%;
    border-radius: 999px;
    background: rgba(56, 189, 248, 0.22);
  }

  .ph-pill.is-drift {
    background: rgba(245, 181, 68, 0.45);
  }

  .ph-pill.is-ok {
    background: rgba(16, 185, 129, 0.45);
  }

  .ph-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4%;
    flex: 1;
  }

  .ph-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 8%;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    background: #12161b;
  }

  .ph-card.is-wide {
    grid-column: span 2;
  }

  .ph-card .ph-cell {
    block-size: 8px;
  }

  .ph-spark {
    block-size: 30%;
    border-block-end: 2px solid rgba(16, 185, 129, 0.5);
    background: linear-gradient(to top, rgba(16, 185, 129, 0.12), transparent);
    clip-path: polygon(
      0 80%,
      15% 55%,
      30% 65%,
      48% 30%,
      62% 45%,
      80% 15%,
      100% 35%,
      100% 100%,
      0 100%
    );
  }

  .ph-racks {
    display: flex;
    justify-content: center;
    gap: 8%;
    flex: 1;
  }

  .ph-rack {
    display: flex;
    flex-direction: column;
    gap: 3%;
    inline-size: 22%;
    padding: 3%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
  }

  .ph-unit {
    flex: 1;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.05);
  }

  .ph-unit.is-filled {
    background: rgba(255, 255, 255, 0.16);
  }

  .ph-unit.is-tall {
    flex: 2.2;
    background: rgba(16, 185, 129, 0.35);
  }

  .ph-graph {
    flex: 1;
    inline-size: 100%;
  }

  .ph-graph path {
    fill: none;
    stroke: rgba(16, 185, 129, 0.6);
    stroke-width: 1.5;
  }

  .ph-graph .ph-graph-obs {
    stroke: rgba(56, 189, 248, 0.6);
    stroke-dasharray: 4 4;
  }

  .ph-graph rect {
    fill: #171c22;
    stroke: rgba(255, 255, 255, 0.18);
  }

  .ph-caption {
    position: absolute;
    inset-block-end: 4%;
    inset-inline-end: 3%;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    background: rgba(11, 13, 16, 0.85);
    color: #a3adb8;
    font-size: 0.75rem;
  }
</style>
