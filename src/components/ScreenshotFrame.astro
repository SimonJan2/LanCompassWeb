---
/**
 * A product screenshot in a device-less window frame drawn in CSS. Serves the
 * capture from src/assets/screens/<set>/<locale>/<screen>.png (set: survey, or night-chart
 * in a dark build; an auto build ships both in one <picture>) through Astro's image
 * pipeline (WebP at 800 and 1600 px, explicit size; two widths keep the markup short
 * — 800 covers phones, 1600 covers 2× desktop frames). While a capture is missing it
 * renders a schematic placeholder of the same 16:10 shape. Screenshots are never
 * mirrored: the frame takes the screenshot's own direction.
 */
import { getImage } from "astro:assets";
import { fill, locales, useUi, type Locale } from "../i18n";
import { site } from "../config/site";
import { findScreen, type ScreenKey, type ScreenVariant } from "../lib/screens";

interface Props {
  screen: ScreenKey;
  /** Locale of the page (alt text language). */
  locale: Locale;
  /** Locale of the screenshot itself; defaults to the page locale. */
  screenLocale?: Locale;
  sizes?: string;
  eager?: boolean;
  /** One WebP at this width instead of a srcset: for small, repeated frames (the atlas
   *  previews), where the srcset markup would outweigh the benefit. Light set only in auto. */
  single?: number;
  /** The srcset's WebP widths (default 800 and 1600). A narrow slot takes [800]: one URL per
   *  set keeps the home page inside its first round trip. */
  widths?: number[];
  /** With `single`, in an auto build: the dark set's image behind a prefers-color-scheme: dark
   *  source too (one URL each), for single frames that must follow the scheme. */
  singleDark?: boolean;
  /** A preview that repeats what the text beside it names (the atlas): empty alt text. */
  decorative?: boolean;
  /** Editorial crop: the frame's shape. Captures are 16:10; "wide" crops to 2:1 from the top. */
  crop?: "full" | "wide";
  /** "focus": a narrow slot shows the capture's focus crop (`<key>.focus.png`) when there is
   *  one, so its text stays readable; "full" (default) shows the whole window. */
  variant?: ScreenVariant;
  class?: string;
}

const {
  screen,
  locale,
  screenLocale = locale,
  sizes = "(min-width: 1200px) 640px, (min-width: 768px) 50vw, 100vw",
  eager = false,
  single,
  widths = [800, 1600],
  singleDark = false,
  decorative = false,
  crop = "full",
  variant = "full",
  class: className,
} = Astro.props;
const ui = useUi(locale);
const name = ui.screenshot.screens[screen];
const image = findScreen(site.theme, screenLocale, screen, variant);
/** WebP only, in every theme (W2): every image URL in the HTML is an incompressible hash, and
 *  the home page must stay inside its first round trip (10 TCP segments) for its LCP budget.
 *  auto: the dark-set capture behind a prefers-color-scheme: dark source, so the browser
 *  fetches only the one that matches; the small single-width atlas previews stay light (and step
 *  aside under a dark scheme: AtlasIndex.astro). */
const darkImage =
  site.theme === "auto" ? findScreen("night-chart", screenLocale, screen, variant) : null;
const darkMedia = "(prefers-color-scheme: dark)";
const srcset = async (src: NonNullable<typeof image>) => {
  const fit = widths.filter((w) => w <= src.width);
  const out = await Promise.all(
    (fit.length ? fit : [src.width]).map(
      async (w) => `${(await getImage({ src, width: w, format: "webp" })).src} ${w}w`,
    ),
  );
  return out.join(", ");
};
const picture =
  image && !single
    ? {
        dark: darkImage ? await srcset(darkImage) : null,
        light: await srcset(image),
        fallback: await getImage({
          src: image,
          width: Math.min(Math.max(...widths), image.width),
          format: "webp",
        }),
      }
    : null;
const pattern =
  screen === "rack" || screen === "rack-studio"
    ? "rack"
    : screen === "topology-observed" ||
        screen === "map-ages" ||
        screen === "ask-the-map" ||
        screen === "design-studio"
      ? "graph"
      : screen === "dashboard" || screen === "gallery"
        ? "cards"
        : "table";
const screenDir = locales[screenLocale].dir;
const singleImage =
  image && single
    ? await getImage({ src: image, width: Math.min(single, image.width), format: "webp" })
    : null;
const singleDarkImage =
  singleImage && singleDark && darkImage
    ? await getImage({ src: darkImage, width: Math.min(single!, darkImage.width), format: "webp" })
    : null;
const plainName = name.replace(/<[^>]+>/g, "");
const alt = decorative ? "" : fill(ui.screenshot.alt, { screen: plainName });
---

<div
  class:list={["shot", `crop-${crop}`, className]}
  data-screen={screen}
  data-captured={image ? "true" : "false"}
>
  <div class="shot-bar" aria-hidden="true"></div>
  {image && picture ? (
    <picture>
      {picture.dark && <source media={darkMedia} srcset={picture.dark} sizes={sizes} />}
      <img
        src={picture.fallback.src}
        srcset={picture.light}
        sizes={sizes}
        alt={alt}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        width={image.width}
        height={image.height}
        class="shot-img"
      />
    </picture>
  ) : image && singleImage && singleDarkImage ? (
    <picture>
      <source media={darkMedia} srcset={singleDarkImage.src} />
      <img
        src={singleImage.src}
        width={singleImage.attributes.width}
        height={singleImage.attributes.height}
        alt={alt}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        class="shot-img"
      />
    </picture>
  ) : image && singleImage ? (
    <img
      src={singleImage.src}
      width={singleImage.attributes.width}
      height={singleImage.attributes.height}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class="shot-img"
    />
  ) : (
    <div
      class:list={["shot-placeholder", `pattern-${pattern}`]}
      dir={screenDir}
      role="img"
      aria-label={fill(ui.screenshot.placeholder, { screen: plainName })}
    >
      <div class="ph-side">
        <span class="ph-logo" />
        {Array.from({ length: 5 }, (_, i) => (
          <span class:list={["ph-nav", i === 2 && "is-active"]} />
        ))}
      </div>
      <div class="ph-main">
        <div class="ph-top">
          <span class="ph-title" />
          <span class="ph-btn" />
        </div>
        {pattern === "table" &&
          Array.from({ length: 6 }, (_, i) => (
            <div class="ph-row">
              <span class="ph-cell w-30" />
              <span class="ph-cell w-20" />
              <span class:list={["ph-pill", i === 3 && "is-drift", i === 5 && "is-ok"]} />
              <span class="ph-cell w-15" />
            </div>
          ))}
        {pattern === "cards" && (
          <div class="ph-cards">
            {Array.from({ length: 6 }, (_, i) => (
              <div class:list={["ph-card", i === 0 && "is-wide"]}>
                <span class="ph-cell w-40" />
                <span class="ph-spark" />
              </div>
            ))}
          </div>
        )}
        {pattern === "rack" && (
          <div class="ph-racks">
            {Array.from({ length: 3 }, () => (
              <div class="ph-rack">
                {Array.from({ length: 10 }, (_, i) => (
                  <span
                    class:list={["ph-unit", i % 3 === 0 && "is-filled", i === 4 && "is-tall"]}
                  />
                ))}
              </div>
            ))}
          </div>
        )}
        {pattern === "graph" && (
          <svg class="ph-graph" viewBox="0 0 400 220" aria-hidden="true">
            <path d="M60 50L200 40L340 60M60 50L120 160M200 40L210 170M340 60L300 170M120 160L210 170" />
            <path class="ph-graph-obs" d="M300 170L360 190M210 170L300 170" />
            {[
              [60, 50],
              [200, 40],
              [340, 60],
              [120, 160],
              [210, 170],
              [300, 170],
              [360, 190],
            ].map(([x, y]) => (
              <rect x={(x ?? 0) - 18} y={(y ?? 0) - 9} width="36" height="18" rx="5" />
            ))}
          </svg>
        )}
      </div>
      <span class="ph-caption" set:html={name} />
    </div>
  )}
</div>

<style is:global>
  /* The window: since W3 the product's own themes are the site's pair (a Survey window on
     survey paper, a Night chart window on Night chart), so the frame gives the window an edge
     of its own: the strong hairline (ΔE2000 ≥ 10 from the page ground, tests/identity.spec.ts),
     a raised plate and a sunk title bar, and a box-shadow in the site's indigo, never black.
     (Comments here avoid bare Tailwind words: Tailwind scans every file for class names.) */
  .shot {
    overflow: hidden;
    border: 1px solid var(--lc-rule-strong);
    border-radius: var(--lc-radius);
    background: var(--lc-paper-raised);
    box-shadow: 0 30px 60px -40px var(--lc-shadow);
  }

  /* The title bar's three window dots, drawn (no elements: W2 keeps the home page inside its
     first round trip): 8 px rings at the bar's left, whatever the reading direction. */
  .shot .shot-bar {
    --dot: radial-gradient(
      circle,
      transparent 3px,
      var(--lc-rule-strong) 3px 4px,
      transparent 4.5px
    );
    block-size: 27px;
    border-block-end: 1px solid var(--lc-rule-strong);
    background:
      var(--dot) 12px 9px / 8px 8px no-repeat,
      var(--dot) 26px 9px / 8px 8px no-repeat,
      var(--dot) 40px 9px / 8px 8px no-repeat,
      var(--lc-paper-sunk);
  }

  .shot .shot-img {
    inline-size: 100%;
    block-size: auto;
  }

  .shot picture {
    display: block;
  }

  /* Editorial crop: a wide band from the top of the capture. */
  .shot.crop-wide picture {
    aspect-ratio: 2 / 1;
    overflow: hidden;
  }

  .shot.crop-wide .shot-img {
    block-size: 100%;
    object-fit: cover;
    object-position: top;
  }

  /* Placeholder: a schematic of the product in the site's own paper tones. */
  .shot .shot-placeholder {
    position: relative;
    display: grid;
    grid-template-columns: 15% 1fr;
    aspect-ratio: 16 / 10;
    background: var(--lc-paper-raised);
  }

  .shot.crop-wide .shot-placeholder {
    aspect-ratio: 2 / 1;
  }

  .shot .ph-side {
    display: flex;
    flex-direction: column;
    gap: 9%;
    padding: 6% 12%;
    border-inline-end: 1px solid var(--lc-rule);
    background: var(--lc-paper);
  }

  .shot .ph-logo {
    inline-size: 60%;
    block-size: 6%;
    border-radius: 2px;
    background: var(--lc-ink);
    opacity: 0.75;
  }

  .shot .ph-nav {
    block-size: 3.5%;
    border-radius: 2px;
    background: var(--lc-rule);
  }

  .shot .ph-nav.is-active {
    background: var(--lc-ink-faint);
  }

  .shot .ph-main {
    display: flex;
    flex-direction: column;
    gap: 3.5%;
    padding: 4% 5%;
    min-inline-size: 0;
  }

  .shot .ph-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    block-size: 8%;
  }

  .shot .ph-title {
    inline-size: 32%;
    block-size: 55%;
    border-radius: 2px;
    background: var(--lc-rule-strong);
  }

  .shot .ph-btn {
    inline-size: 14%;
    block-size: 70%;
    border-radius: 2px;
    background: var(--lc-action);
  }

  .shot .ph-row {
    display: flex;
    align-items: center;
    gap: 4%;
    block-size: 6.5%;
    padding-inline: 2%;
    border-block-end: 1px solid var(--lc-rule);
  }

  .shot .ph-cell {
    block-size: 36%;
    border-radius: 2px;
    background: var(--lc-rule);
  }

  .shot .w-15 {
    inline-size: 15%;
  }
  .shot .w-20 {
    inline-size: 20%;
  }
  .shot .w-30 {
    inline-size: 30%;
  }
  .shot .w-40 {
    inline-size: 40%;
  }

  .shot .ph-pill {
    inline-size: 11%;
    block-size: 50%;
    border-radius: 2px;
    background: var(--lc-observed-wash);
    box-shadow: inset 0 0 0 1px var(--lc-observed);
  }

  .shot .ph-pill.is-drift {
    background: var(--lc-drift-wash);
    box-shadow: inset 0 0 0 1px var(--lc-drift);
  }

  .shot .ph-pill.is-ok {
    background: var(--lc-documented-wash);
    box-shadow: inset 0 0 0 1px var(--lc-documented-line);
  }

  .shot .ph-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4%;
    flex: 1;
  }

  .shot .ph-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 8%;
    border: 1px solid var(--lc-rule);
    border-radius: 2px;
    background: var(--lc-paper);
  }

  .shot .ph-card.is-wide {
    grid-column: span 2;
  }

  .shot .ph-card .ph-cell {
    block-size: 8px;
  }

  .shot .ph-spark {
    block-size: 30%;
    border-block-end: 1.5px solid var(--lc-observed);
    background: linear-gradient(to top, var(--lc-observed-wash), transparent);
    clip-path: polygon(
      0 80%,
      15% 55%,
      30% 65%,
      48% 30%,
      62% 45%,
      80% 15%,
      100% 35%,
      100% 100%,
      0 100%
    );
  }

  .shot .ph-racks {
    display: flex;
    justify-content: center;
    gap: 8%;
    flex: 1;
  }

  .shot .ph-rack {
    display: flex;
    flex-direction: column;
    gap: 3%;
    inline-size: 22%;
    padding: 3%;
    border: 1px solid var(--lc-rule-strong);
    border-radius: 2px;
  }

  .shot .ph-unit {
    flex: 1;
    border-radius: 1px;
    background: var(--lc-paper-sunk);
  }

  .shot .ph-unit.is-filled {
    background: var(--lc-rule-strong);
  }

  .shot .ph-unit.is-tall {
    flex: 2.2;
    background: var(--lc-ink-faint);
  }

  .shot .ph-graph {
    flex: 1;
    inline-size: 100%;
  }

  .shot .ph-graph path {
    fill: none;
    stroke: var(--lc-ink-faint);
    stroke-width: 1.4;
  }

  .shot .ph-graph .ph-graph-obs {
    stroke: var(--lc-observed);
    stroke-dasharray: 3 4;
  }

  .shot .ph-graph rect {
    fill: var(--lc-paper);
    stroke: var(--lc-ink-faint);
  }

  .shot .ph-caption {
    position: absolute;
    inset-block-end: 4%;
    inset-inline-end: 3%;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--lc-rule-strong);
    border-radius: 2px;
    background: var(--lc-paper-raised);
    color: var(--lc-ink-muted);
    font-family: var(--lc-font-mono);
    font-size: 0.72rem;
  }

  :lang(he) .shot .ph-caption {
    font-family: var(--lc-font-sans);
  }
</style>
