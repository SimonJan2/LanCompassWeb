---
/**
 * A product screenshot in a device-less window frame drawn in CSS. Since W11 each slot shows a
 * crop of its own size around the one thing its caption names, drawn at the product's own size
 * or larger (DECISIONS.md D-LEGIBLE; src/content/screen-slots.json): the files are
 * /screens/<set>/<locale>/<key>.<slot>.webp (and <key>.<slot>-phone.webp), cut by the capture
 * script at exactly twice the width the slot draws them (set: survey, or night-chart in a dark
 * build; an auto build ships both). One <picture>, one candidate per <source>: the phone crop
 * below the breakpoint, the desktop crop as the <img>, and in auto the Night chart twin of each
 * behind a prefers-color-scheme: dark source, so the browser fetches only the one that matches.
 * No srcset width list: each file is the one size its slot needs. While a capture is missing it
 * renders a schematic placeholder of the same 16:10 shape. Screenshots are never mirrored: the
 * frame takes the screenshot's own direction.
 */
import { fill, locales, useUi, type Locale } from "../i18n";
import { site } from "../config/site";
import {
  PHONE_MEDIA,
  screenSets,
  slotPictures,
  type ScreenKey,
  type ScreenSet,
  type ServedScreen,
  type SlotKind,
} from "../lib/screens";

interface Props {
  screen: ScreenKey;
  /** Locale of the page (alt text language). */
  locale: Locale;
  /** Locale of the screenshot itself; defaults to the page locale. */
  screenLocale?: Locale;
  /** The slot kind (screen-slots.json): which crop, and whether a phone gets its own. */
  slot: SlotKind;
  eager?: boolean;
  /** A preview that repeats what the text beside it names (the atlas): empty alt text. */
  decorative?: boolean;
  /** Editorial crop: the frame's shape. Captures are 16:10; "wide" crops to 2:1 from the top. */
  crop?: "full" | "wide";
  /** W13 (D-SHOWCASE): one set, whatever the build's theme — the showcase shows both official
   *  themes side by side, so its pictures never follow the page's scheme. */
  set?: ScreenSet;
  class?: string;
}

const {
  screen,
  locale,
  screenLocale = locale,
  slot,
  eager = false,
  decorative = false,
  crop = "full",
  set,
  class: className,
} = Astro.props;
const ui = useUi(locale);
const name = ui.screenshot.screens[screen];
/** The atlas previews stay in the light set in auto: their nine Night chart twins would not fit
 *  the home page's first round trip, so under a dark scheme they step aside (AtlasIndex.astro);
 *  under a dark override the theme switch shows their Night chart files (src/scripts/site.ts). */
const sets: ScreenSet[] = set
  ? [set]
  : slot === "atlas" && site.theme === "auto"
    ? ["survey"]
    : screenSets(site.theme);
const [lightSet, darkSet] = sets;
const light = slotPictures(slot, lightSet!, screenLocale, screen);
const dark = darkSet ? slotPictures(slot, darkSet, screenLocale, screen) : null;
const image: ServedScreen | null = light.desktop;
const darkMedia = "(prefers-color-scheme: dark)";
/** The <source>s, in the order the browser tries them: a phone's dark crop, a phone's crop, the
 *  dark desktop crop; the <img> is the light desktop crop. */
const sources = image
  ? [
      dark?.phone && { media: `${darkMedia} and ${PHONE_MEDIA}`, src: dark.phone.src },
      light.phone && { media: PHONE_MEDIA, src: light.phone.src },
      dark?.desktop && { media: darkMedia, src: dark.desktop.src },
    ].filter((s): s is { media: string; src: string } => !!s)
  : [];
const pattern =
  screen === "rack" || screen === "rack-studio"
    ? "rack"
    : screen === "topology-observed" ||
        screen === "map-ages" ||
        screen === "ask-the-map" ||
        screen === "design-studio"
      ? "graph"
      : screen === "dashboard" || screen === "gallery"
        ? "cards"
        : "table";
const screenDir = locales[screenLocale].dir;
const plainName = name.replace(/<[^>]+>/g, "");
const alt = decorative ? "" : fill(ui.screenshot.alt, { screen: plainName });
/** W4: an annotated figure (AnnotatedScreen.astro) passes its marks as the default slot. The
 *  picture and the marks then share one positioned box, so the marks cover exactly the picture
 *  whatever mat a theme puts around it. Frames without marks render exactly as before. */
const marked = Astro.slots.has("default") && image !== null;
const Pic = marked ? "div" : Fragment;
const picProps = marked ? { class: "shot-pic" } : {};
---

<div
  class:list={["shot", `crop-${crop}`, className]}
  data-screen={screen}
  data-captured={image ? "true" : "false"}
>
  <div class="shot-bar" aria-hidden="true"></div>
  <Pic {...picProps}>
    {image && sources.length > 0 ? (
      <picture>
        {sources.map((s) => (
          <source media={s.media} srcset={s.src} />
        ))}
        <img
          src={image.src}
          width={image.width}
          height={image.height}
          alt={alt}
          loading={eager ? "eager" : "lazy"}
          decoding="async"
          class="shot-img"
        />
      </picture>
    ) : image ? (
      <img
        src={image.src}
        width={image.width}
        height={image.height}
        alt={alt}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        class="shot-img"
      />
    ) : (
      <div
        class:list={["shot-placeholder", `pattern-${pattern}`]}
        dir={screenDir}
        role="img"
        aria-label={fill(ui.screenshot.placeholder, { screen: plainName })}
      >
        <div class="ph-side">
          <span class="ph-logo" />
          {Array.from({ length: 5 }, (_, i) => (
            <span class:list={["ph-nav", i === 2 && "is-active"]} />
          ))}
        </div>
        <div class="ph-main">
          <div class="ph-top">
            <span class="ph-title" />
            <span class="ph-btn" />
          </div>
          {pattern === "table" &&
            Array.from({ length: 6 }, (_, i) => (
              <div class="ph-row">
                <span class="ph-cell w-30" />
                <span class="ph-cell w-20" />
                <span class:list={["ph-pill", i === 3 && "is-drift", i === 5 && "is-ok"]} />
                <span class="ph-cell w-15" />
              </div>
            ))}
          {pattern === "cards" && (
            <div class="ph-cards">
              {Array.from({ length: 6 }, (_, i) => (
                <div class:list={["ph-card", i === 0 && "is-wide"]}>
                  <span class="ph-cell w-40" />
                  <span class="ph-spark" />
                </div>
              ))}
            </div>
          )}
          {pattern === "rack" && (
            <div class="ph-racks">
              {Array.from({ length: 3 }, () => (
                <div class="ph-rack">
                  {Array.from({ length: 10 }, (_, i) => (
                    <span
                      class:list={["ph-unit", i % 3 === 0 && "is-filled", i === 4 && "is-tall"]}
                    />
                  ))}
                </div>
              ))}
            </div>
          )}
          {pattern === "graph" && (
            <svg class="ph-graph" viewBox="0 0 400 220" aria-hidden="true">
              <path d="M60 50L200 40L340 60M60 50L120 160M200 40L210 170M340 60L300 170M120 160L210 170" />
              <path class="ph-graph-obs" d="M300 170L360 190M210 170L300 170" />
              {[
                [60, 50],
                [200, 40],
                [340, 60],
                [120, 160],
                [210, 170],
                [300, 170],
                [360, 190],
              ].map(([x, y]) => (
                <rect x={(x ?? 0) - 18} y={(y ?? 0) - 9} width="36" height="18" rx="5" />
              ))}
            </svg>
          )}
        </div>
        <span class="ph-caption" set:html={name} />
      </div>
    )}
    {marked && <slot />}
  </Pic>
</div>

<style is:global>
  /* The window: since W3 the product's own themes are the site's pair (a Survey window on
     survey paper, a Night chart window on Night chart), so the frame gives the window an edge
     of its own: the strong hairline (ΔE2000 ≥ 10 from the page ground, tests/identity.spec.ts),
     a raised plate and a sunk title bar, and a box-shadow in the site's indigo, never black.
     (Comments here avoid bare Tailwind words: Tailwind scans every file for class names.) */
  .shot {
    overflow: hidden;
    border: 1px solid var(--lc-rule-strong);
    border-radius: var(--lc-radius);
    background: var(--lc-paper-raised);
    box-shadow: 0 30px 60px -40px var(--lc-shadow);
  }

  /* The title bar's three window dots, drawn (no elements: W2 keeps the home page inside its
     first round trip): 8 px rings at the bar's left, whatever the reading direction. */
  .shot .shot-bar {
    --dot: radial-gradient(
      circle,
      transparent 3px,
      var(--lc-rule-strong) 3px 4px,
      transparent 4.5px
    );
    block-size: 27px;
    border-block-end: 1px solid var(--lc-rule-strong);
    background:
      var(--dot) 12px 9px / 8px 8px no-repeat,
      var(--dot) 26px 9px / 8px 8px no-repeat,
      var(--dot) 40px 9px / 8px 8px no-repeat,
      var(--lc-paper-sunk);
  }

  .shot .shot-img {
    inline-size: 100%;
    block-size: auto;
  }

  .shot picture {
    display: block;
  }

  /* Editorial crop: a wide band from the top of the capture. */
  .shot.crop-wide picture {
    aspect-ratio: 2 / 1;
    overflow: hidden;
  }

  .shot.crop-wide .shot-img {
    block-size: 100%;
    object-fit: cover;
    object-position: top;
  }

  /* Placeholder: a schematic of the product in the site's own paper tones. */
  .shot .shot-placeholder {
    position: relative;
    display: grid;
    grid-template-columns: 15% 1fr;
    aspect-ratio: 16 / 10;
    background: var(--lc-paper-raised);
  }

  .shot.crop-wide .shot-placeholder {
    aspect-ratio: 2 / 1;
  }

  .shot .ph-side {
    display: flex;
    flex-direction: column;
    gap: 9%;
    padding: 6% 12%;
    border-inline-end: 1px solid var(--lc-rule);
    background: var(--lc-paper);
  }

  .shot .ph-logo {
    inline-size: 60%;
    block-size: 6%;
    border-radius: 2px;
    background: var(--lc-ink);
    opacity: 0.75;
  }

  .shot .ph-nav {
    block-size: 3.5%;
    border-radius: 2px;
    background: var(--lc-rule);
  }

  .shot .ph-nav.is-active {
    background: var(--lc-ink-faint);
  }

  .shot .ph-main {
    display: flex;
    flex-direction: column;
    gap: 3.5%;
    padding: 4% 5%;
    min-inline-size: 0;
  }

  .shot .ph-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    block-size: 8%;
  }

  .shot .ph-title {
    inline-size: 32%;
    block-size: 55%;
    border-radius: 2px;
    background: var(--lc-rule-strong);
  }

  .shot .ph-btn {
    inline-size: 14%;
    block-size: 70%;
    border-radius: 2px;
    background: var(--lc-action);
  }

  .shot .ph-row {
    display: flex;
    align-items: center;
    gap: 4%;
    block-size: 6.5%;
    padding-inline: 2%;
    border-block-end: 1px solid var(--lc-rule);
  }

  .shot .ph-cell {
    block-size: 36%;
    border-radius: 2px;
    background: var(--lc-rule);
  }

  .shot .w-15 {
    inline-size: 15%;
  }
  .shot .w-20 {
    inline-size: 20%;
  }
  .shot .w-30 {
    inline-size: 30%;
  }
  .shot .w-40 {
    inline-size: 40%;
  }

  .shot .ph-pill {
    inline-size: 11%;
    block-size: 50%;
    border-radius: 2px;
    background: var(--lc-observed-wash);
    box-shadow: inset 0 0 0 1px var(--lc-observed);
  }

  .shot .ph-pill.is-drift {
    background: var(--lc-drift-wash);
    box-shadow: inset 0 0 0 1px var(--lc-drift);
  }

  .shot .ph-pill.is-ok {
    background: var(--lc-documented-wash);
    box-shadow: inset 0 0 0 1px var(--lc-documented-line);
  }

  .shot .ph-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4%;
    flex: 1;
  }

  .shot .ph-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 8%;
    border: 1px solid var(--lc-rule);
    border-radius: 2px;
    background: var(--lc-paper);
  }

  .shot .ph-card.is-wide {
    grid-column: span 2;
  }

  .shot .ph-card .ph-cell {
    block-size: 8px;
  }

  .shot .ph-spark {
    block-size: 30%;
    border-block-end: 1.5px solid var(--lc-observed);
    background: linear-gradient(to top, var(--lc-observed-wash), transparent);
    clip-path: polygon(
      0 80%,
      15% 55%,
      30% 65%,
      48% 30%,
      62% 45%,
      80% 15%,
      100% 35%,
      100% 100%,
      0 100%
    );
  }

  .shot .ph-racks {
    display: flex;
    justify-content: center;
    gap: 8%;
    flex: 1;
  }

  .shot .ph-rack {
    display: flex;
    flex-direction: column;
    gap: 3%;
    inline-size: 22%;
    padding: 3%;
    border: 1px solid var(--lc-rule-strong);
    border-radius: 2px;
  }

  .shot .ph-unit {
    flex: 1;
    border-radius: 1px;
    background: var(--lc-paper-sunk);
  }

  .shot .ph-unit.is-filled {
    background: var(--lc-rule-strong);
  }

  .shot .ph-unit.is-tall {
    flex: 2.2;
    background: var(--lc-ink-faint);
  }

  .shot .ph-graph {
    flex: 1;
    inline-size: 100%;
  }

  .shot .ph-graph path {
    fill: none;
    stroke: var(--lc-ink-faint);
    stroke-width: 1.4;
  }

  .shot .ph-graph .ph-graph-obs {
    stroke: var(--lc-observed);
    stroke-dasharray: 3 4;
  }

  .shot .ph-graph rect {
    fill: var(--lc-paper);
    stroke: var(--lc-ink-faint);
  }

  .shot .ph-caption {
    position: absolute;
    inset-block-end: 4%;
    inset-inline-end: 3%;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--lc-rule-strong);
    border-radius: 2px;
    background: var(--lc-paper-raised);
    color: var(--lc-ink-muted);
    font-family: var(--lc-font-mono);
    font-size: 0.72rem;
  }

  :lang(he) .shot .ph-caption {
    font-family: var(--lc-font-sans);
  }
</style>
