---
/**
 * A video slot. While public/media/<key>.mp4 (or .webm) is missing it shows a
 * poster panel with "Video coming soon". With the file present: <video> with
 * controls, no autoplay, preload="none" and en + he caption tracks. The poster is a lazy
 * <img> under the video rather than the poster attribute, which browsers fetch at once:
 * nothing of the video loads until the visitor scrolls near it. No caption track is marked
 * `default`, because a default track is fetched with the page; both stay in the player's menu.
 */
import Icon from "./Icon.astro";
import { locales, useUi, type Locale } from "../i18n";
import { videoFiles } from "../lib/media";

interface Props {
  locale: Locale;
  videoKey: string;
  title: string;
}

const { locale, videoKey, title } = Astro.props;
const ui = useUi(locale);
const files = videoFiles(videoKey);
const ready = files.mp4 !== null || files.webm !== null;
/** A 1×1 transparent GIF: without any poster Chrome paints the video black over the lazy
 *  poster image; a data: URI costs no request (the CSP allows data: images). */
const transparentPoster =
  "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
const captionLabels: Record<Locale, string> = Object.fromEntries(
  Object.entries(locales).map(([code, meta]) => [code, meta.label]),
) as Record<Locale, string>;
---

<figure class="video" data-video={videoKey} data-video-ready={ready ? "true" : "false"}>
  {ready ? (
    <div class="video-frame">
      {files.poster && (
        <img
          class="video-poster-img"
          src={files.poster}
          alt=""
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
        />
      )}
      <video
        controls
        preload="none"
        playsinline
        width="1280"
        height="720"
        class="video-el"
        poster={files.poster ? transparentPoster : undefined}
      >
        {files.webm && <source src={files.webm} type="video/webm" />}
        {files.mp4 && <source src={files.mp4} type="video/mp4" />}
        {files.captions.map((c) => (
          <track
            kind="captions"
            src={c.src}
            srclang={locales[c.locale].htmlLang}
            label={captionLabels[c.locale]}
          />
        ))}
      </video>
    </div>
  ) : (
    <div class="video-poster">
      <span class="video-play" aria-hidden="true">
        <Icon name="play" size={30} />
      </span>
      <span class="video-soon">{ui.video.comingSoon}</span>
    </div>
  )}
  <figcaption class="video-title" set:html={title} />
</figure>

<style>
  .video {
    margin: 0;
  }

  .video-frame {
    position: relative;
  }

  .video-poster-img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    border-radius: var(--lc-radius);
    object-fit: cover;
  }

  .video-el {
    position: relative;
    display: block;
  }

  /* See-through until playback, so the lazy poster underneath shows. */
  .video-frame .video-el {
    background: transparent;
  }

  .video-el,
  .video-poster {
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--lc-rule-strong);
    border-radius: var(--lc-radius);
    background: var(--lc-paper-raised);
  }

  .video-poster {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    overflow: hidden;
  }

  .video-play {
    display: grid;
    place-items: center;
    inline-size: 3.25rem;
    block-size: 3.25rem;
    border: 1px solid var(--lc-ink-faint);
    border-radius: 50%;
    color: var(--lc-ink-muted);
  }

  .video-soon {
    color: var(--lc-ink-muted);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-text-xs);
  }

  :lang(he) .video-soon {
    font-family: var(--lc-font-sans);
  }

  .video-title {
    margin-block-start: 0.875rem;
    font-size: var(--lc-text-body);
    font-weight: 550;
  }
</style>
