---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Logo from "./Logo.astro";
import { site } from "../config/site";
import { pagePath, useUi, type Locale, type PageKey } from "../i18n";

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const ui = useUi(locale);
const f = ui.footer;
const home = pagePath(locale, "home");
const columns = [
  {
    title: f.product,
    links: [
      { href: pagePath(locale, "product"), label: f.overview },
      { href: `${home}#how-it-works`, label: f.howItWorks },
      { href: `${home}#integrations`, label: f.integrations },
      { href: pagePath(locale, "security"), label: f.security },
      ...(site.docsUrl ? [{ href: site.docsUrl, label: f.docs, flag: "docs" }] : []),
      ...(site.githubUrl ? [{ href: site.githubUrl, label: f.source, flag: "github" }] : []),
    ],
  },
  {
    title: f.company,
    links: [
      { href: pagePath(locale, "design-partners"), label: f.designPartners },
      { href: pagePath(locale, "contact"), label: f.contact },
    ],
  },
  {
    title: f.legal,
    links: [
      { href: pagePath(locale, "privacy"), label: f.privacy },
      { href: pagePath(locale, "accessibility"), label: f.accessibility },
    ],
  },
] as { title: string; links: { href: string; label: string; flag?: string }[] }[];
const year = new Date().getFullYear();
---

<footer class="site-footer" id="site-footer">
  <div class="container-site">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo href={home} label={ui.nav.home} />
        <p class="footer-positioning">{f.positioning}</p>
      </div>
      <nav class="footer-nav" id="footer-nav" aria-label={f.navLabel}>
        {columns.map((col) => (
          <div class="footer-col">
            <h2 class="footer-col-title">{col.title}</h2>
            <ul role="list">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} data-flag={link.flag}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="footer-bottom">
      <LanguageSwitcher locale={locale} page={page} variant="list" />
      <p class="footer-legal">
        <span class="tabular">© {year}</span>
        <bdi translate="no">{f.rights}</bdi>
        <span aria-hidden="true">·</span>
        <span>{f.madeIn}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 4.5rem 2.5rem;
    border-block-start: 1px solid var(--lc-hairline);
    background: var(--lc-ink);
  }

  .footer-grid {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .footer-grid {
      grid-template-columns: 5fr 7fr;
    }
  }

  .footer-positioning {
    max-inline-size: 22rem;
    margin-block-start: 1rem;
    color: var(--lc-text-muted);
    font-size: var(--lc-text-small);
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 2rem;
  }

  .footer-col-title {
    margin-block-end: 0.875rem;
    color: var(--lc-text-faint);
    font-size: var(--lc-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  :lang(he) .footer-col-title {
    letter-spacing: 0;
    font-size: var(--lc-text-small);
  }

  .footer-col ul {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-col a {
    color: var(--lc-text-muted);
    font-size: var(--lc-text-small);
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--lc-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-block-start: 3.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--lc-hairline);
  }

  .footer-legal {
    display: flex;
    gap: 0.5rem;
    color: var(--lc-text-faint);
    font-size: var(--lc-text-small);
  }
</style>
