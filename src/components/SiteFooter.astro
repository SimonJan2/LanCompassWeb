---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import BearingScale from "./motifs/BearingScale.astro";
import Logo from "./Logo.astro";
import { site } from "../config/site";
import {
  pagePath,
  sectionPath,
  useUi,
  type Locale,
  type LocalePaths,
  type PageKey,
  type SectionKey,
} from "../i18n";

interface Props {
  locale: Locale;
  page: PageKey | SectionKey;
  paths?: LocalePaths | undefined;
}

const { locale, page, paths } = Astro.props;
const ui = useUi(locale);
const f = ui.footer;
const home = pagePath(locale, "home");
const columns = [
  {
    title: f.product,
    links: [
      { href: pagePath(locale, "product"), label: f.overview },
      { href: `${home}#how-it-works`, label: f.howItWorks },
      { href: `${home}#integrations`, label: f.integrations },
      { href: pagePath(locale, "security"), label: f.security },
      { href: pagePath(locale, "verify"), label: f.verify },
      // W8: the release notes.
      { href: sectionPath(locale, "changelog"), label: f.releaseNotes },
      // W9: the docs on the site; PUBLIC_DOCS_URL, when set, still wins.
      site.docsUrl
        ? { href: site.docsUrl, label: f.docs, flag: "docs" }
        : { href: sectionPath(locale, "docs"), label: f.docs },
    ],
  },
  {
    title: f.company,
    links: [
      { href: pagePath(locale, "pilot"), label: f.pilot },
      { href: pagePath(locale, "licensing"), label: f.licensing },
      { href: pagePath(locale, "contact"), label: f.contact },
    ],
  },
  {
    title: f.legal,
    links: [
      { href: pagePath(locale, "privacy"), label: f.privacy },
      { href: pagePath(locale, "accessibility"), label: f.accessibility },
    ],
  },
] as { title: string; links: { href: string; label: string; flag?: string }[] }[];
const year = new Date().getFullYear();
---

<footer class="site-footer defer-render" id="site-footer">
  <BearingScale class="footer-scale" />
  <div class="container-site">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo href={home} label={ui.nav.home} />
        <p class="footer-positioning">{f.positioning}</p>
      </div>
      <nav class="footer-nav" id="footer-nav" aria-label={f.navLabel}>
        {columns.map((col) => (
          <div class="footer-col">
            <h2 class="footer-col-title">{col.title}</h2>
            <ul role="list">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} data-flag={link.flag}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="footer-bottom">
      <LanguageSwitcher locale={locale} page={page} paths={paths} variant="list" />
      <p class="footer-legal">
        <span class="tabular">© {year}</span>
        <bdi translate="no">{f.rights}</bdi>
        <span aria-hidden="true">·</span>
        <span>{f.madeIn}</span>
      </p>
    </div>
  </div>
</footer>

<style is:global>
  .site-footer {
    padding-block: 0 2.5rem;
    background: var(--lc-paper-sunk);
  }

  .site-footer .footer-scale {
    margin-block-end: 4rem;
  }

  .site-footer .footer-grid {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .site-footer .footer-grid {
      grid-template-columns: 5fr 7fr;
    }
  }

  .site-footer .footer-positioning {
    max-inline-size: 22rem;
    margin-block-start: 1rem;
    color: var(--lc-ink-muted);
    font-size: var(--lc-text-small);
  }

  .site-footer .footer-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 2rem;
  }

  .site-footer .footer-col-title {
    margin-block-end: 0.875rem;
    padding-block-end: 0.5rem;
    border-block-end: 1px solid var(--lc-rule-strong);
    color: var(--lc-ink-faint);
    font-family: var(--lc-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  :lang(he) .site-footer .footer-col-title {
    letter-spacing: 0;
    font-family: var(--lc-font-sans);
    font-size: var(--lc-text-xs);
  }

  .site-footer .footer-col ul {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer .footer-col a {
    color: var(--lc-ink-muted);
    font-size: var(--lc-text-small);
    text-decoration: none;
  }

  .site-footer .footer-col a:hover {
    color: var(--lc-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .site-footer .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-block-start: 3.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--lc-rule-strong);
  }

  .site-footer .footer-legal {
    display: flex;
    gap: 0.5rem;
    color: var(--lc-ink-faint);
    font-size: var(--lc-text-small);
  }
</style>
