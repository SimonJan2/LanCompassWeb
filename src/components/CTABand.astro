---
import Button from "./Button.astro";
import Contours from "./motifs/Contours.astro";
import { uid } from "../lib/uid";

/** A closing call to action on a night band (counts as one of a page's two night bands). */
interface Props {
  title: string;
  text?: string;
  href: string;
  button: string;
}

const { title, text, href, button } = Astro.props;
const titleId = uid("cta-title");
---

<section class="cta-band surface-night defer-render" aria-labelledby={titleId}>
  <Contours map="quiet" tone="night" />
  <div class="container-site">
    <div class="cta-inner reveal">
      <div>
        <h2 id={titleId} class="cta-title" set:html={title} />
        {text && <p class="cta-text" set:html={text} />}
      </div>
      <Button href={href}>{button}</Button>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
  }

  .cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem 3rem;
  }

  .cta-title {
    max-inline-size: 36rem;
    font-size: var(--lc-text-h2);
  }

  .cta-text {
    max-inline-size: 36rem;
    margin-block-start: 1rem;
    color: var(--lc-ink-muted);
    font-size: var(--lc-text-lead);
  }
</style>
