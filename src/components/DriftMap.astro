---
/**
 * The Drift map: a small network as documented (calm emerald), an observed
 * link the documentation lacks (amber, dashed, with a finding chip), and the
 * same link once documented (emerald, "Documented"). Loops every 12 s.
 *
 * The static styles ARE the resolved frame, so reduced motion (and any browser
 * without animation) shows it. All animation sits behind
 * prefers-reduced-motion: no-preference. A CSS-only pause switch satisfies
 * WCAG 2.2.2 without JavaScript; src/scripts/drift-map.ts pauses it offscreen.
 * The picture is never mirrored: the stage is always left-to-right.
 */
import { locales, useUi, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = useUi(locale);
const dir = locales[locale].dir;

const nodes = [
  { id: "fw-edge-01", x: 280, y: 58, w: 112 },
  { id: "sw-core-01", x: 150, y: 168, w: 112 },
  { id: "sw-core-02", x: 410, y: 168, w: 112 },
  { id: "sw-floor-2", x: 78, y: 300, w: 108 },
  { id: "srv-vm-07", x: 250, y: 300, w: 104 },
  { id: "ap-lobby-3", x: 470, y: 330, w: 108 },
];
const pos = Object.fromEntries(nodes.map((n) => [n.id, n]));
const documented: [string, string][] = [
  ["fw-edge-01", "sw-core-01"],
  ["fw-edge-01", "sw-core-02"],
  ["sw-core-01", "sw-core-02"],
  ["sw-core-01", "sw-floor-2"],
  ["sw-core-01", "srv-vm-07"],
  ["sw-core-02", "srv-vm-07"],
];
const edge = (a: string, b: string) => {
  const p = pos[a]!;
  const q = pos[b]!;
  return `M${p.x} ${p.y}L${q.x} ${q.y}`;
};
const ghost = edge("sw-core-02", "ap-lobby-3");
---

<figure class="drift" data-drift-map>
  <div class="drift-stage" dir="ltr" role="img" aria-label={ui.drift.label}>
    <svg viewBox="0 0 560 400" class="drift-svg" aria-hidden="true" focusable="false">
      <g class="drift-grid">
        {Array.from({ length: 13 }, (_, i) => (
          <path d={`M${i * 48 + 4} 0V400`} />
        ))}
        {Array.from({ length: 9 }, (_, i) => (
          <path d={`M0 ${i * 48 + 8}H560`} />
        ))}
      </g>
      <g class="edges-documented">
        {documented.map(([a, b]) => (
          <path d={edge(a, b)} />
        ))}
      </g>
      <path class="edge-ghost" d={ghost}></path>
      <path class="edge-resolved" d={ghost}></path>
      <circle class="probe" r="3.5" cx="0" cy="0"></circle>
      {nodes.map((n) => (
        <g
          class:list={["node", n.id === "ap-lobby-3" && "node-target"]}
          transform={`translate(${n.x} ${n.y})`}
        >
          {n.id === "ap-lobby-3" && (
            <rect class="node-halo" x={-n.w / 2 - 6} y="-22" width={n.w + 12} height="44" rx="12" />
          )}
          <rect class="node-box" x={-n.w / 2} y="-16" width={n.w} height="32" rx="8" />
          <circle class="node-dot" cx={-n.w / 2 + 14} cy="0" r="3" />
          <text x={-n.w / 2 + 25} y="4.5">
            {n.id}
          </text>
        </g>
      ))}
    </svg>
    <div class="chips">
      <p class="chip chip-finding" dir={dir} lang={locales[locale].htmlLang}>
        <span class="chip-mark" aria-hidden="true"></span>
        <span>{ui.drift.finding}</span>
        <span class="chip-sep" aria-hidden="true">
          ·
        </span>
        <bdi class="chip-id">sw-core-02 ↔ ap-lobby-3</bdi>
      </p>
      <p class="chip chip-resolved" dir={dir} lang={locales[locale].htmlLang}>
        <span class="chip-mark" aria-hidden="true"></span>
        <span>{ui.drift.resolved}</span>
        <span class="chip-sep" aria-hidden="true">
          ·
        </span>
        <bdi class="chip-id">sw-core-02 ↔ ap-lobby-3</bdi>
      </p>
    </div>
  </div>
  <figcaption class="drift-legend">
    <span class="legend-item">
      <span class="legend-line legend-documented" aria-hidden="true"></span>
      {ui.drift.documented}
    </span>
    <span class="legend-item">
      <span class="legend-line legend-observed" aria-hidden="true"></span>
      {ui.drift.observed}
    </span>
    <label class="drift-pause">
      <input type="checkbox" data-drift-pause />
      <span>{ui.drift.pause}</span>
    </label>
  </figcaption>
</figure>

<script>
  import "../scripts/drift-map.ts";
</script>

<style>
  .drift {
    margin: 0;
  }

  .drift-stage {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--lc-hairline);
    border-radius: var(--lc-radius);
    background:
      radial-gradient(120% 80% at 50% 0%, rgba(16, 185, 129, 0.07), transparent 60%),
      var(--lc-ink-raised);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 30px 80px -40px rgba(0, 0, 0, 0.8);
  }

  .drift-svg {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 560 / 400;
  }

  .drift-grid path {
    stroke: rgba(255, 255, 255, 0.035);
    stroke-width: 1;
  }

  .edges-documented path {
    stroke: #10b981;
    stroke-opacity: 0.75;
    stroke-width: 1.6;
    fill: none;
  }

  .edge-ghost {
    stroke: #f5b544;
    stroke-width: 2;
    stroke-dasharray: 6 6;
    fill: none;
    opacity: 0;
  }

  .edge-resolved {
    stroke: #10b981;
    stroke-width: 2;
    fill: none;
    opacity: 1;
  }

  .probe {
    fill: #38bdf8;
    opacity: 0;
  }

  .node-box {
    fill: #171c22;
    stroke: rgba(255, 255, 255, 0.14);
    stroke-width: 1;
  }

  .node-dot {
    fill: #10b981;
  }

  .node-halo {
    fill: none;
    stroke: #f5b544;
    stroke-width: 1.5;
    stroke-dasharray: 3 4;
    opacity: 0;
  }

  .node text {
    fill: #d5dbe1;
    font-family: var(--lc-font-mono);
    font-size: 12.5px;
    letter-spacing: 0;
  }

  /* The chips sit beside the undocumented link. The wrapper is positioned in the
     stage's own left-to-right picture space; each chip keeps the page's direction. */
  .chips {
    position: absolute;
    inset-block-start: 56%;
    inset-inline-end: 23%;
    display: grid;
    justify-items: end;
  }

  .chip {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0.375rem 0.625rem;
    border: 1px solid;
    border-radius: 999px;
    background: #0b0d10;
    font-size: 0.78rem;
    font-weight: 550;
    line-height: 1.2;
    white-space: nowrap;
    box-shadow: 0 10px 30px -12px rgba(0, 0, 0, 0.9);
  }

  .chip-id {
    font-family: var(--lc-font-mono);
    font-size: 0.72rem;
    font-weight: 450;
    color: #d5dbe1;
  }

  .chip-sep {
    color: var(--lc-text-faint);
  }

  .chip-mark {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 2px;
  }

  .chip-finding {
    border-color: rgba(245, 181, 68, 0.55);
    color: #f5b544;
    opacity: 0;
  }

  .chip-finding .chip-mark {
    background: #f5b544;
    rotate: 45deg;
  }

  .chip-resolved {
    border-color: rgba(52, 211, 153, 0.5);
    color: #34d399;
    opacity: 1;
  }

  .chip-resolved .chip-mark {
    background: #34d399;
    border-radius: 50%;
  }

  @media (max-width: 520px) {
    .chips {
      inset-block-start: auto;
      inset-block-end: 0.75rem;
      inset-inline-end: 0.75rem;
      max-inline-size: calc(100% - 1.5rem);
    }

    .chip {
      max-inline-size: 100%;
    }

    .chip-id {
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  .drift-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-block-start: 0.875rem;
    color: var(--lc-text-muted);
    font-size: var(--lc-text-xs);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .legend-line {
    inline-size: 1.5rem;
    block-size: 0;
    border-block-start: 2px solid #10b981;
  }

  .legend-observed {
    border-block-start: 2px dashed #f5b544;
  }

  .drift-pause {
    display: none;
    align-items: center;
    gap: 0.4rem;
    margin-inline-start: auto;
    cursor: pointer;
  }

  .drift-pause input {
    inline-size: 1rem;
    block-size: 1rem;
    margin: 0;
    accent-color: #10b981;
  }

  @media (prefers-reduced-motion: no-preference) {
    .drift-pause {
      display: inline-flex;
    }

    .edge-ghost {
      animation:
        ghost 12s linear infinite both,
        march 1.2s linear infinite;
    }

    .edge-resolved {
      animation: resolved 12s linear infinite both;
    }

    .node-halo {
      animation: ghost 12s linear infinite both;
    }

    .probe {
      animation: probe 12s linear infinite both;
    }

    .chip-finding {
      animation: chip-finding 12s var(--lc-ease) infinite both;
    }

    .chip-resolved {
      animation: chip-resolved 12s var(--lc-ease) infinite both;
    }

    .drift:has([data-drift-pause]:checked)
      :is(.edge-ghost, .edge-resolved, .node-halo, .probe, .chip),
    .drift[data-offscreen] :is(.edge-ghost, .edge-resolved, .node-halo, .probe, .chip) {
      animation-play-state: paused;
    }
  }

  @keyframes ghost {
    0%,
    12% {
      opacity: 0;
    }
    22%,
    62% {
      opacity: 1;
    }
    70%,
    100% {
      opacity: 0;
    }
  }

  @keyframes march {
    to {
      stroke-dashoffset: -12;
    }
  }

  @keyframes resolved {
    0%,
    62% {
      opacity: 0;
    }
    70%,
    88% {
      opacity: 1;
    }
    96%,
    100% {
      opacity: 0;
    }
  }

  /* The observed probe travels the undocumented link (sw-core-02 → ap-lobby-3). */
  @keyframes probe {
    0%,
    11% {
      opacity: 0;
      transform: translate(410px, 168px);
    }
    13% {
      opacity: 0.9;
      transform: translate(410px, 168px);
    }
    25% {
      opacity: 0.9;
      transform: translate(470px, 330px);
    }
    28%,
    100% {
      opacity: 0;
      transform: translate(470px, 330px);
    }
  }

  @keyframes chip-finding {
    0%,
    26% {
      opacity: 0;
      transform: translateY(4px);
    }
    32%,
    60% {
      opacity: 1;
      transform: none;
    }
    66%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  @keyframes chip-resolved {
    0%,
    66% {
      opacity: 0;
      transform: translateY(4px);
    }
    72%,
    86% {
      opacity: 1;
      transform: none;
    }
    93%,
    100% {
      opacity: 0;
      transform: none;
    }
  }
</style>
