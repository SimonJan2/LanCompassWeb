---
/**
 * Marginal annotations set in mono, like the notes on a network drawing:
 * subnets and demo-estate names only (the fictional `10.20.0.0/16` estate).
 * Decorative: hidden from assistive technology, always left-to-right.
 */
interface Props {
  notes: string[];
  class?: string;
}

const { notes, class: className } = Astro.props;
---

<ul class:list={["marginalia", className]} aria-hidden="true" dir="ltr" role="list">
  {notes.map((note) => (
    <li>{note}</li>
  ))}
</ul>

<style>
  .marginalia {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--lc-ink-faint);
    font-family: var(--lc-font-mono);
    font-size: 0.75rem;
    line-height: 1.3;
    unicode-bidi: isolate;
  }

  .marginalia li::before {
    content: "— ";
    color: var(--lc-rule-strong);
  }
</style>
