---
import Icon from "./Icon.astro";

/**
 * primary: emerald fill. secondary: hairline outline. tertiary: text link with an arrow
 * (the arrow mirrors in RTL).
 */
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "tertiary";
  class?: string;
  arrow?: boolean;
  [key: `data-${string}`]: string | undefined;
}

const { href, variant = "primary", class: className, arrow, ...rest } = Astro.props;
const showArrow = arrow ?? variant === "tertiary";
---

<a href={href} class:list={["btn", `btn-${variant}`, className]} {...rest}>
  <span>
    <slot />
  </span>
  {showArrow && <Icon name="arrow" size={18} class="btn-arrow" />}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-block-size: 2.875rem;
    padding: 0.625rem 1.25rem;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .btn-primary {
    background: var(--lc-signal);
    color: #0b0d10;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }

  .btn-primary:hover {
    background: #22c58f;
  }

  .btn-secondary {
    border: 1px solid var(--lc-hairline-strong);
    color: var(--lc-text);
    background: transparent;
  }

  .btn-secondary:hover {
    border-color: var(--lc-signal);
  }

  .btn-tertiary {
    min-block-size: auto;
    padding: 0.25rem 0;
    color: var(--lc-signal-bright);
    white-space: normal;
  }

  .btn-tertiary:hover span {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .btn {
      transition:
        background-color 160ms ease,
        border-color 160ms ease;
    }

    .btn :global(.btn-arrow) {
      transition: translate 160ms var(--lc-ease);
    }

    .btn:hover :global(.btn-arrow) {
      translate: 2px 0;
    }

    [dir="rtl"] .btn:hover :global(.btn-arrow) {
      translate: -2px 0;
    }
  }
</style>
