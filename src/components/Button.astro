---
import Icon from "./Icon.astro";

/**
 * primary: ink fill on paper (paper fill on night). secondary: ink outline. tertiary: text link with an arrow
 * (the arrow mirrors in RTL).
 */
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "tertiary";
  class?: string;
  arrow?: boolean;
  [key: `data-${string}`]: string | undefined;
}

const { href, variant = "primary", class: className, arrow, ...rest } = Astro.props;
const showArrow = arrow ?? variant === "tertiary";
---

<a href={href} class:list={["btn", `btn-${variant}`, className]} {...rest}>
  <span>
    <slot />
  </span>
  {showArrow && <Icon name="arrow" size={18} class="btn-arrow" />}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-block-size: 2.875rem;
    padding: 0.625rem 1.25rem;
    border: 1px solid transparent;
    border-radius: var(--lc-radius-sm);
    font-size: 1rem;
    font-weight: 550;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  :lang(he) .btn {
    font-weight: 500;
  }

  /* Primary: ink on paper (paper on night). */
  .btn-primary {
    background: var(--lc-action);
    color: var(--lc-action-text);
  }

  .btn-primary:hover {
    background: var(--lc-action-hover);
  }

  .btn-secondary {
    border-color: var(--lc-ink);
    color: var(--lc-ink);
    background: transparent;
  }

  .btn-secondary:hover {
    background: var(--lc-paper-raised);
  }

  .btn-tertiary {
    min-block-size: auto;
    padding: 0.25rem 0;
    border: 0;
    color: var(--lc-ink);
    white-space: normal;
  }

  .btn-tertiary span {
    text-decoration: underline;
    text-decoration-color: var(--lc-rule-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .btn-tertiary:hover span {
    text-decoration-color: currentColor;
  }

  @media (prefers-reduced-motion: no-preference) {
    .btn {
      transition:
        background-color var(--lc-dur-micro) ease,
        border-color var(--lc-dur-micro) ease;
    }

    .btn span {
      transition: text-decoration-color var(--lc-dur-micro) ease;
    }

    .btn :global(.btn-arrow) {
      transition: translate var(--lc-dur-ui) var(--lc-spring);
    }

    .btn:hover :global(.btn-arrow) {
      translate: 3px 0;
    }

    [dir="rtl"] .btn:hover :global(.btn-arrow) {
      translate: -3px 0;
    }
  }
</style>
