---
/**
 * W9: a docs article — the product's own help page — in three regions: the category navigation
 * (every category with its articles, in the product's order), the article (the site's Prose) and
 * "On this page" (the article's h2/h3). The two side columns stay in view by CSS only. On a phone
 * the category navigation sits in a native <details> disclosure; from 760 px it is always open
 * (::details-content; a browser without it keeps the disclosure). No JavaScript. Every page
 * carries the version line ("Docs for LanCompass 0.7.0 — the help built into the product").
 */
import type { MarkdownHeading } from "astro";
import plexMonoFont from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
// Not drawn on an article, but imported: every other page draws the contour motif, and Vite
// keeps its rules in the one stylesheet all pages share only while all pages import it.
// Without this line every page outside the docs loads one more stylesheet (night D report).
import "../components/motifs/Contours.astro";
import "../components/Eyebrow.astro";
import BaseLayout from "./BaseLayout.astro";
import { site } from "../config/site";
import { getCopy } from "../content/copy";
import {
  absoluteUrl,
  fill,
  pagePath,
  sectionPath,
  useUi,
  type Locale,
  type LocalePaths,
} from "../i18n";
import { byCategory, chromeHtml, docPath, type DocPage } from "../lib/docs";

interface Props {
  locale: Locale;
  page: DocPage;
  pages: DocPage[];
  headings: MarkdownHeading[];
  paths: LocalePaths;
  previous?: DocPage | undefined;
  next?: DocPage | undefined;
}

const { locale, page, pages, headings, paths, previous, next } = Astro.props;
const copy = getCopy(locale);
const c = copy.docs;
const groups = byCategory(pages);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const title = `${page.data.title} — ${copy.meta.docs.title}`;
const isolate = (s: string) => chromeHtml(s, locale);
/** W10: the article's place in the site, as structured data (LanCompass → Docs → the article). */
const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    [site.name, pagePath(locale, "home")],
    [useUi(locale).nav.docs, sectionPath(locale, "docs")],
    [page.data.title, docPath(locale, page.slug)],
  ].map(([name, path], i) => ({
    "@type": "ListItem",
    position: i + 1,
    name,
    item: absoluteUrl(path!),
  })),
};
---

<BaseLayout
  locale={locale}
  page="docs"
  paths={paths}
  title={title}
  description={page.data.description}
>
  {/* A Hebrew article with code preloads the mono face (BaseLayout preloads the Hebrew ones):
       found late, it swapped in after the first paint and shifted the whole long page
       (CLS 0.097 on /he/docs/topology/). English pages preload nothing more: every early font
       request lengthens Lighthouse's pessimistic LCP (the English topology article measured
       1.80-1.81 s with three more preloads, night D report), and their swap shifts little. */}
  {locale !== "en" && page.fonts.mono && (
    <link slot="head" rel="preload" href={plexMonoFont} as="font" type="font/woff2" crossorigin />
  )}
  <div class="container-site docs-shell">
    <nav class="docs-nav" aria-label={c.nav}>
      <details class="docs-nav-toggle">
        <summary>{c.allGuides}</summary>
        <div class="docs-nav-body">
          <p class="docs-nav-home">
            <a href={sectionPath(locale, "docs")}>{c.index}</a>
          </p>
          {groups.map((g) =>
            g.category === page.data.category ? (
              <div class="docs-nav-group docs-nav-current">
                <p class="docs-nav-title" set:html={c.categories[g.category]} />
                <ul role="list">
                  {g.pages.map((p) => (
                    <li>
                      <a
                        href={docPath(locale, p.slug)}
                        aria-current={p.slug === page.slug ? "page" : undefined}
                        set:html={isolate(p.data.title)}
                      />
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <p class="docs-nav-group">
                <a
                  class="docs-nav-cat"
                  href={`${sectionPath(locale, "docs")}#cat-${g.category}`}
                  set:html={c.categories[g.category]}
                />
              </p>
            ),
          )}
        </div>
      </details>
    </nav>
    <article class="docs-article">
      <p class="docs-version" set:html={fill(c.versionLine, { version: page.data.version })} />
      {page.data.stale && (
        <p class="docs-stale" role="note">
          {c.stale}
        </p>
      )}
      <div class="docs-prose">
        <slot />
      </div>
      {(previous || next) && (
        <nav class="docs-pager" aria-label={`${c.previous} · ${c.next}`}>
          {previous && (
            <a href={docPath(locale, previous.slug)} rel="prev" class="docs-pager-prev">
              <span class="docs-pager-label">{c.previous}</span>
              <span set:html={isolate(previous.data.title)} />
            </a>
          )}
          {next && (
            <a href={docPath(locale, next.slug)} rel="next" class="docs-pager-next">
              <span class="docs-pager-label">{c.next}</span>
              <span set:html={isolate(next.data.title)} />
            </a>
          )}
        </nav>
      )}
    </article>
    {toc.length > 0 && (
      <div class="docs-toc">
        <nav aria-label={c.onThisPage}>
          <p class="docs-toc-title">{c.onThisPage}</p>
          <ul role="list">
            {toc.map((h) => (
              <li class={h.depth === 3 ? "docs-toc-sub" : undefined}>
                <a href={`#${h.slug}`} set:html={isolate(h.text)} />
              </li>
            ))}
          </ul>
        </nav>
      </div>
    )}
  </div>
  {/* After the article, not in the head: the long articles sit at the edge of their LCP budget,
       and 84 B more ahead of the article put /docs/topology/ at 1.80 s in auto (night E). */}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
</BaseLayout>

<style>
  .docs-shell {
    display: grid;
    gap: 1.5rem 2.5rem;
    padding-block: 1.5rem 4rem;
  }

  @media (min-width: 760px) {
    .docs-shell {
      grid-template-columns: minmax(12rem, 15rem) minmax(0, 1fr);
      padding-block-start: 2.5rem;
    }

    .docs-toc {
      grid-column: 2;
    }
  }

  @media (min-width: 1200px) {
    .docs-shell {
      grid-template-columns: minmax(12rem, 15rem) minmax(0, 1fr) minmax(11rem, 14rem);
    }

    .docs-toc {
      grid-column: 3;
      grid-row: 1;
    }
  }

  /* The category navigation. */
  .docs-nav {
    font-size: var(--lc-text-small);
  }

  @media (min-width: 760px) {
    .docs-nav {
      position: sticky;
      inset-block-start: 5.25rem;
      align-self: start;
      max-block-size: calc(100dvh - 6.5rem);
      overflow-y: auto;
    }
  }

  @media (min-width: 1200px) {
    .docs-toc nav {
      position: sticky;
      inset-block-start: 5.25rem;
      max-block-size: calc(100dvh - 6.5rem);
      overflow-y: auto;
    }
  }

  .docs-nav-toggle > summary {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--lc-ink);
    border-radius: var(--lc-radius-sm);
    color: var(--lc-ink);
    font-weight: 500;
    cursor: pointer;
  }

  .docs-nav-toggle[open] > summary {
    margin-block-end: 1rem;
  }

  @supports selector(::details-content) {
    @media (min-width: 760px) {
      .docs-nav-toggle > summary {
        display: none;
      }

      .docs-nav-toggle::details-content {
        content-visibility: visible;
        display: block;
      }
    }
  }

  .docs-nav-home {
    margin-block-end: 1rem;
  }

  .docs-nav-group + .docs-nav-group {
    margin-block-start: 0.5rem;
  }

  .docs-nav-current {
    margin-block: 1rem;
  }

  .docs-nav .docs-nav-cat,
  .docs-nav-title {
    margin-block-end: 0.375rem;
    color: var(--lc-ink-faint);
    font-family: var(--lc-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  :lang(he) .docs-nav .docs-nav-cat,
  :lang(he) .docs-nav-title {
    font-family: var(--lc-font-sans);
    font-size: var(--lc-text-xs);
    letter-spacing: 0;
  }

  .docs-nav ul,
  .docs-toc ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-nav a,
  .docs-toc a {
    display: inline-block;
    padding-block: 0.125rem;
    color: var(--lc-ink-muted);
    text-decoration: none;
  }

  .docs-nav a:hover,
  .docs-toc a:hover {
    color: var(--lc-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .docs-nav a[aria-current="page"] {
    color: var(--lc-ink);
    font-weight: 600;
  }

  /* The article. */
  .docs-article {
    min-inline-size: 0;
  }

  .docs-version {
    margin-block-end: 1.5rem;
    color: var(--lc-ink-faint);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-text-xs);
  }

  :lang(he) .docs-version {
    font-family: var(--lc-font-sans);
  }

  .docs-stale {
    margin-block-end: 1.5rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--lc-rule-strong);
    border-inline-start: 3px solid var(--lc-ink);
    border-radius: var(--lc-radius-sm);
    background: var(--lc-paper-raised);
    color: var(--lc-ink);
    font-size: var(--lc-text-small);
  }

  /* Prose.astro's rules, folded in here: one stylesheet request fewer on every docs page. */
  .docs-prose {
    max-inline-size: 46rem;
    color: var(--lc-ink-muted);
  }

  /* The long articles (topology: ~1,900 elements) are laid out lazily below their first screen:
     the browser skips the layout and paint of blocks it has not reached (and keeps them in the
     accessibility tree, find-in-page and anchor links). */
  .docs-prose > :global(:nth-child(n + 12):not(h2, h3, h4)) {
    content-visibility: auto;
    contain-intrinsic-size: auto 6rem;
  }

  .docs-prose :global(h2) {
    margin-block: 3.5rem 0.875rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--lc-rule-strong);
    color: var(--lc-ink);
    font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem);
    letter-spacing: -0.015em;
  }

  .docs-prose :global(h3) {
    margin-block: 2rem 0.5rem;
    color: var(--lc-ink);
    font-size: var(--lc-text-h3);
  }

  .docs-prose :global(p),
  .docs-prose :global(ul),
  .docs-prose :global(ol) {
    margin-block: 0 1rem;
  }

  .docs-prose :global(ul),
  .docs-prose :global(ol) {
    padding-inline-start: 1.25rem;
  }

  .docs-prose :global(li) {
    margin-block-end: 0.4rem;
    padding-inline-start: 0.25rem;
  }

  .docs-prose :global(li::marker) {
    color: var(--lc-ink-faint);
  }

  .docs-prose :global(strong) {
    color: var(--lc-ink);
  }

  .docs-prose :global(a) {
    color: var(--lc-ink);
    text-decoration: underline;
    text-decoration-color: var(--lc-ink-faint);
    text-underline-offset: 3px;
  }

  .docs-prose :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .docs-prose :global(code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--lc-rule);
    border-radius: 2px;
    background: var(--lc-paper-raised);
    color: var(--lc-ink);
  }

  .docs-prose :global(h1) {
    margin-block-end: 1.25rem;
    color: var(--lc-ink);
    font-size: clamp(1.875rem, 1.4rem + 2vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .docs-prose :global(h2),
  .docs-prose :global(h3),
  .docs-prose :global(h4) {
    scroll-margin-block-start: 5.5rem;
  }

  .docs-prose :global(h1 + h2) {
    margin-block-start: 2rem;
  }

  .docs-prose :global(h4) {
    margin-block: 1.5rem 0.5rem;
    color: var(--lc-ink);
  }

  .docs-prose :global(ul) {
    list-style: disc;
  }

  .docs-prose :global(ol) {
    list-style: decimal;
  }

  .docs-prose :global(li > ul),
  .docs-prose :global(li > ol) {
    margin-block: 0.4rem 0;
  }

  .docs-prose :global(pre) {
    margin-block: 0 1.25rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--lc-rule);
    border-radius: var(--lc-radius-sm);
    background: var(--lc-paper-raised);
    color: var(--lc-ink);
    font-family: var(--lc-font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    text-align: start;
  }

  .docs-prose :global(pre code) {
    padding: 0;
    border: 0;
    background: none;
    font-size: inherit;
  }

  .docs-prose :global(code) {
    font-family: var(--lc-font-mono);
    font-size: 0.875em;
    overflow-wrap: anywhere;
  }

  .docs-prose :global(code[dir="ltr"]) {
    unicode-bidi: isolate;
  }

  .docs-prose :global(blockquote) {
    margin-block: 0 1.25rem;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--lc-rule-strong);
  }

  .docs-prose :global(.docs-table) {
    margin-block: 0 1.25rem;
    overflow-x: auto;
    border: 1px solid var(--lc-rule);
    border-radius: var(--lc-radius-sm);
  }

  .docs-prose :global(.docs-table:focus-visible) {
    outline: 2px solid var(--lc-ink);
    outline-offset: 2px;
  }

  .docs-prose :global(table) {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--lc-text-small);
  }

  .docs-prose :global(th),
  .docs-prose :global(td) {
    padding: 0.5rem 0.75rem;
    border-block-end: 1px solid var(--lc-rule);
    text-align: start;
    vertical-align: top;
  }

  .docs-prose :global(th) {
    color: var(--lc-ink);
    font-weight: 600;
  }

  .docs-prose :global(img) {
    display: block;
    max-inline-size: 100%;
    block-size: auto;
    margin-block: 0.5rem 1.25rem;
    border: 1px solid var(--lc-rule);
    border-radius: var(--lc-radius-sm);
  }

  .docs-prose :global(.docs-callout) {
    margin-block: 0 1.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--lc-rule-strong);
    border-inline-start: 3px solid var(--lc-ink-muted);
    border-radius: var(--lc-radius-sm);
    background: var(--lc-paper-raised);
  }

  .docs-prose :global(.docs-callout-warning),
  .docs-prose :global(.docs-callout-caution),
  .docs-prose :global(.docs-callout-danger) {
    border-inline-start-color: var(--lc-drift);
  }

  .docs-prose :global(.docs-callout-label) {
    margin-block-end: 0.25rem;
    color: var(--lc-ink);
    font-size: var(--lc-text-small);
    font-weight: 600;
  }

  .docs-prose :global(.docs-callout > :last-child),
  .docs-prose :global(.docs-details > :last-child) {
    margin-block-end: 0;
  }

  .docs-prose :global(.docs-details) {
    margin-block: 0 1.25rem;
    padding: 0.625rem 1rem;
    border: 1px solid var(--lc-rule-strong);
    border-radius: var(--lc-radius-sm);
  }

  .docs-prose :global(.docs-details > summary) {
    color: var(--lc-ink);
    font-weight: 500;
    cursor: pointer;
  }

  .docs-prose :global(.docs-details[open] > summary) {
    margin-block-end: 0.75rem;
  }

  /* Previous / next within the category. */
  .docs-pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    max-inline-size: 46rem;
    margin-block-start: 3rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--lc-rule-strong);
  }

  .docs-pager a {
    display: grid;
    gap: 0.125rem;
    max-inline-size: 20rem;
    color: var(--lc-ink);
    text-decoration: none;
  }

  .docs-pager a:hover span:last-child {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .docs-pager-next {
    margin-inline-start: auto;
    text-align: end;
  }

  .docs-pager-label {
    color: var(--lc-ink-faint);
    font-size: var(--lc-text-xs);
  }

  /* On this page. */
  .docs-toc {
    font-size: var(--lc-text-small);
  }

  .docs-toc-title {
    margin-block-end: 0.5rem;
    color: var(--lc-ink);
    font-weight: 600;
  }

  .docs-toc-sub {
    padding-inline-start: 0.875rem;
  }

  @media (max-width: 759px) {
    .docs-toc {
      padding-block-start: 1.5rem;
      border-block-start: 1px solid var(--lc-rule);
    }
  }
</style>
