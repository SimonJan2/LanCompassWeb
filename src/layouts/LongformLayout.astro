---
/**
 * A long-form page: rendered from src/content/pages/<locale>/<page>.mdx (security, privacy,
 * accessibility), or (W8) a section page that brings its own hero and body — a release's notes —
 * with its locale twins' paths for canonical, hreflang and the switcher.
 */
import { getEntry, render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Prose from "../components/Prose.astro";
import Contours from "../components/motifs/Contours.astro";
import { getCopy } from "../content/copy";
import { locales, useUi, type Locale, type LocalePaths, type PageKey } from "../i18n";

interface MdxPage {
  locale: Locale;
  page: Extract<PageKey, "security" | "privacy" | "accessibility">;
}

interface SectionPage {
  locale: Locale;
  page: "changelog";
  paths: LocalePaths;
  /** The document title and description. */
  title: string;
  description: string;
  hero: {
    eyebrow: string;
    /** HTML: the page's h1. */
    title: string;
    /** HTML: the lead under it. */
    lead: string;
    /** The date line: its label and an ISO date. */
    dateLabel: string;
    date: string;
    /** The date as the page writes it ("6 November 2026"); the locale's long date otherwise. */
    dateText?: string | undefined;
    /** HTML after the date, on the same line (the "Latest" mark). */
    after?: string | undefined;
  };
}

type Props = MdxPage | SectionPage;

const props = Astro.props;
const { locale } = props;
const section = "hero" in props ? props : null;
const formatDate = (iso: string) =>
  new Intl.DateTimeFormat(locales[locale].htmlLang, { dateStyle: "long", timeZone: "UTC" }).format(
    new Date(`${iso}T00:00:00Z`),
  );

let Content: Awaited<ReturnType<typeof render>>["Content"] | null = null;
let hero: SectionPage["hero"];
let legalReview = false;
let meta: { title: string; description: string };
let mdxPage: MdxPage["page"] | null = null;
if (section) {
  hero = section.hero;
  meta = { title: section.title, description: section.description };
} else {
  const page = (props as MdxPage).page;
  mdxPage = page;
  const entry = await getEntry("pages", `${locale}/${page}`);
  if (!entry) throw new Error(`Missing src/content/pages/${locale}/${page}.mdx`);
  ({ Content } = await render(entry));
  meta = getCopy(locale).meta[page];
  legalReview = entry.data.legalReview;
  hero = {
    eyebrow: entry.data.eyebrow,
    title: entry.data.title,
    lead: entry.data.lead,
    dateLabel: useUi(locale).longform.updated,
    date: entry.data.updated,
  };
}
const updated = hero.dateText ?? formatDate(hero.date);
---

<BaseLayout
  locale={locale}
  page={section ? section.page : (mdxPage as MdxPage["page"])}
  paths={section ? section.paths : undefined}
  title={meta.title}
  description={meta.description}
>
  <slot name="head" slot="head" />
  <section class="longform-hero">
    <Contours map="quiet" eager />
    <div class="container-site">
      <Eyebrow>{hero.eyebrow}</Eyebrow>
      <h1 class="longform-title" set:html={hero.title} />
      <p class="text-lead longform-lead" set:html={hero.lead} />
      <p class="longform-updated">
        {hero.dateLabel}: <time datetime={hero.date}>{updated}</time>
        {hero.after && <Fragment set:html={hero.after} />}
      </p>
      {legalReview && (
        <p class="longform-review">
          <span class="todo-operator">
            TODO(operator): legal review of this page before going public.
          </span>
        </p>
      )}
    </div>
  </section>
  <section class="section-tight">
    <div class="container-site longform-body">
      {Content && (
        <Prose>
          <Content />
        </Prose>
      )}
      <slot />
    </div>
  </section>
</BaseLayout>

<style>
  .longform-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(2.5rem, 2rem + 2vw, 3.5rem);
    border-block-end: 1px solid var(--lc-rule);
  }

  .longform-title {
    max-inline-size: 48rem;
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
  }

  .longform-lead {
    max-inline-size: 44rem;
    margin-block-start: 1.25rem;
  }

  .longform-updated {
    margin-block-start: 1.5rem;
    color: var(--lc-ink-faint);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-text-xs);
  }

  :lang(he) .longform-updated {
    font-family: var(--lc-font-sans);
  }

  .longform-review {
    margin-block-start: 1rem;
  }

  .longform-body {
    display: grid;
    gap: 3rem;
  }
</style>
