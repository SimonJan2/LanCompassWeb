---
import type { GetStaticPaths } from "astro";
import LongformLayout from "../../layouts/LongformLayout.astro";

import { localeStaticPaths, type Locale } from "../../i18n";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<LongformLayout locale={locale} page="accessibility" />
