---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABand from "../../components/CTABand.astro";
import Icon from "../../components/Icon.astro";
import ScreenshotFrame from "../../components/ScreenshotFrame.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Contours from "../../components/motifs/Contours.astro";
import { getCopy } from "../../content/copy";
import { localeStaticPaths, pagePath, useUi, type Locale } from "../../i18n";
import { isScreenKey } from "../../lib/screens";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const p = copy.product;
const ui = useUi(locale);
---

<BaseLayout
  locale={locale}
  page="product"
  title={copy.meta.product.title}
  description={copy.meta.product.description}
>
  <section class="product-hero">
    <Contours map="quiet" eager />
    <div class="container-site">
      <SectionHeading eyebrow={p.eyebrow} title={p.title} lead={p.lead} level={1} />
    </div>
  </section>

  <nav class="subnav" aria-label={ui.productNav} data-scrollspy>
    <div class="container-site">
      <ul role="list" class="subnav-list">
        {p.sections.map((s) => (
          <li>
            <a href={`#${s.id}`} data-spy-link={s.id} set:html={s.nav} />
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <div class="container-site product-sections">
    {p.sections.map((s, index) => (
      <section
        class:list={["capability", index > 0 && "defer-render"]}
        id={s.id}
        aria-labelledby={`${s.id}-title`}
        data-spy-section
      >
        <div class="capability-head">
          <p class="capability-index" aria-hidden="true" dir="ltr">
            {String(index + 1).padStart(2, "0")} / {String(p.sections.length).padStart(2, "0")}
          </p>
          <h2 id={`${s.id}-title`} class="capability-title" set:html={s.title} />
        </div>
        <div class="capability-body">
          <p class="capability-intro" set:html={s.intro} />
          <ul class="capability-bullets" role="list">
            {s.bullets.map((b) => (
              <li>
                <Icon name="check" size={16} class="capability-check" />
                <span set:html={b} />
              </li>
            ))}
          </ul>
          <p class="capability-note">
            <strong>{ui.goodToKnow}:</strong> <span set:html={s.note} />
          </p>
          {isScreenKey(s.screen) && (
            <div class="capability-visual reveal">
              <ScreenshotFrame
                screen={s.screen}
                locale={locale}
                sizes="(min-width: 1264px) 840px, (min-width: 960px) 66vw, 100vw"
              />
            </div>
          )}
        </div>
      </section>
    ))}
  </div>

  <CTABand
    title={p.cta.title}
    text={p.cta.text}
    href={`${pagePath(locale, "design-partners")}#apply`}
    button={p.cta.button}
  />
</BaseLayout>

<script>
  import "../../scripts/scrollspy.ts";
</script>

<style>
  .product-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .subnav {
    position: sticky;
    inset-block-start: 4.25rem;
    z-index: 40;
    border-block: 1px solid var(--lc-ink);
    background: color-mix(in srgb, var(--lc-paper) 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .subnav-list {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0.5rem 0;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .subnav-list::-webkit-scrollbar {
    display: none;
  }

  .subnav-list a {
    display: inline-block;
    padding: 0.4rem 0.75rem;
    border-radius: var(--lc-radius-sm);
    color: var(--lc-ink-muted);
    font-size: var(--lc-text-small);
    text-decoration: none;
    white-space: nowrap;
  }

  .subnav-list a:hover {
    color: var(--lc-ink);
  }

  .subnav-list a[aria-current="true"] {
    background: var(--lc-action);
    color: var(--lc-action-text);
  }

  .product-sections {
    display: grid;
  }

  .capability {
    display: grid;
    gap: 1.5rem 4rem;
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
    border-block-end: 1px solid var(--lc-rule);
    scroll-margin-block-start: 8rem;
  }

  .capability:last-child {
    border-block-end: 0;
  }

  @media (min-width: 960px) {
    .capability {
      grid-template-columns: 4fr 8fr;
    }

    .capability-head {
      position: sticky;
      inset-block-start: 9rem;
      align-self: start;
    }
  }

  .capability-index {
    inline-size: fit-content;
    min-inline-size: 5rem;
    margin-block-end: 1.25rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--lc-ink);
    color: var(--lc-ink);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-text-mono);
    font-weight: 500;
  }

  .capability-title {
    font-size: clamp(1.75rem, 1.35rem + 1.5vw, 2.5rem);
  }

  .capability-intro {
    max-inline-size: 42rem;
    color: var(--lc-ink-muted);
    font-size: var(--lc-text-lead);
  }

  .capability-intro :global(code) {
    color: var(--lc-ink);
  }

  .capability-bullets {
    display: grid;
    gap: 0.625rem 2rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .capability-bullets {
      grid-template-columns: 1fr 1fr;
    }
  }

  .capability-bullets li {
    display: flex;
    gap: 0.625rem;
    padding-block-end: 0.625rem;
    border-block-end: 1px solid var(--lc-rule);
    font-size: var(--lc-text-small);
  }

  .capability-bullets :global(.capability-check) {
    flex: none;
    margin-block-start: 0.25rem;
    color: var(--lc-documented-line);
  }

  .capability-note {
    margin-block-start: 1.75rem;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--lc-ink);
    color: var(--lc-ink);
    font-size: var(--lc-text-small);
  }

  .capability-visual {
    margin-block-start: 2.5rem;
  }
</style>
