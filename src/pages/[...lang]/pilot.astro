---
/**
 * W7: /pilot/ and /he/pilot/ (DECISIONS.md D-PILOT's default: the design-partners page becomes
 * the pilot page). Sections in order: what a pilot is, what you need before day one, the first
 * 30 days (the product's ten steps), success criteria (the worksheet), support, how a pilot ends,
 * for your security reviewer, the design-partner offer, and #apply (the form). Every product
 * sentence is the product's own (first-run.md, support.md, LICENSE at v0.7.0), cited in the copy
 * files. No script beyond the site's own: the worksheet prints with the site's print styles.
 */
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Form from "../../components/form/Form.astro";
import Prose from "../../components/Prose.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import TwinFrames from "../../components/TwinFrames.astro";
import Contours from "../../components/motifs/Contours.astro";
import { getCopy } from "../../content/copy";
import { localeStaticPaths, pagePath, type Locale } from "../../i18n";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const p = copy.pilot;
---

<BaseLayout
  locale={locale}
  page="pilot"
  title={copy.meta.pilot.title}
  description={copy.meta.pilot.description}
>
  <section class="pl-hero">
    <Contours map="quiet" eager />
    <div class="container-site">
      <SectionHeading eyebrow={p.eyebrow} title={p.title} lead={p.lead} level={1} />
    </div>
  </section>

  {/* W13 (D-SHOWCASE D): what a pilot runs, in both official themes, under the hero. */}
  <div class="container-site pl-twin">
    <TwinFrames locale={locale} />
  </div>

  <div class="container-site pl-body">
    <Prose class="pl-prose">
      <section id="what" aria-labelledby="what-title">
        <h2 id="what-title">{p.what.title}</h2>
        <p set:html={p.what.text} />
        <p set:html={p.what.trying} />
      </section>

      <section id="before-day-one" aria-labelledby="need-title">
        <h2 id="need-title">{p.need.title}</h2>
        <ul>
          {p.need.items.map((item) => (
            <li set:html={item} />
          ))}
        </ul>
      </section>

      <section id="first-30-days" aria-labelledby="days-title">
        <h2 id="days-title">{p.days.title}</h2>
        <p set:html={p.days.lead} />
        <ol class="pl-steps" data-pilot-steps>
          {p.days.steps.map((step) => (
            <li>
              <h3 set:html={step.title} />
              <p set:html={step.text} />
              <p class="pl-done">
                <strong>{p.days.done}</strong> <span set:html={step.done} />
              </p>
            </li>
          ))}
        </ol>
      </section>

      <section id="success-criteria" aria-labelledby="criteria-title">
        <h2 id="criteria-title">{p.criteria.title}</h2>
        <p set:html={p.criteria.lead} />
        <table class="pl-sheet" data-worksheet>
          <caption set:html={p.criteria.caption} />
          <thead>
            <tr>
              {p.criteria.columns.map((c) => (
                <th scope="col" set:html={c} />
              ))}
            </tr>
          </thead>
          <tbody>
            {p.criteria.rows.map((row) => (
              <tr>
                <th scope="row">{row.outcome}</th>
                <td set:html={row.shows} />
                <td />
                <td />
                <td />
              </tr>
            ))}
          </tbody>
        </table>
        <p set:html={p.criteria.note} />
        <table class="pl-sheet pl-sign">
          <caption>{p.criteria.signCaption}</caption>
          <thead>
            <tr>
              {p.criteria.signColumns.map((c) => (
                <th scope="col">{c}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {p.criteria.signRows.map((r) => (
              <tr>
                <th scope="row">{r}</th>
                <td />
                <td />
                <td />
              </tr>
            ))}
          </tbody>
        </table>
        <h3>{p.criteria.reviewTitle}</h3>
        <p set:html={p.criteria.review} />
      </section>

      <section id="support" aria-labelledby="support-title">
        <h2 id="support-title">{p.support.title}</h2>
        <ul>
          {p.support.items.map((item) => (
            <li set:html={item} />
          ))}
        </ul>
      </section>

      <section id="ends" aria-labelledby="ends-title">
        <h2 id="ends-title">{p.ends.title}</h2>
        <p set:html={p.ends.lead} />
        <ol>
          {p.ends.steps.map((step) => (
            <li set:html={step} />
          ))}
        </ol>
      </section>

      <section id="security-review" aria-labelledby="reviewer-title">
        <h2 id="reviewer-title">{p.reviewer.title}</h2>
        <p set:html={p.reviewer.text} />
        <ul>
          <li>
            <a href={pagePath(locale, "security")} set:html={p.reviewer.security} />
          </li>
          <li>
            <a href={pagePath(locale, "verify")}>{p.reviewer.verify}</a>
          </li>
        </ul>
      </section>

      <section id="design-partners" aria-labelledby="partner-title">
        <h2 id="partner-title">{p.partner.title}</h2>
        <p set:html={p.partner.lead} />
        <h3>{p.partner.getsTitle}</h3>
        <ul>
          {p.partner.gets.map((item) => (
            <li set:html={item} />
          ))}
        </ul>
        <h3>{p.partner.asksTitle}</h3>
        <ul>
          {p.partner.asks.map((item) => (
            <li set:html={item} />
          ))}
        </ul>
        <p set:html={p.partner.leave} />
        <p>{p.partner.none}</p>
      </section>
    </Prose>

    <section id="apply" class="pl-apply" aria-labelledby="apply-title">
      <div>
        <h2 id="apply-title">{p.apply.title}</h2>
        <p class="pl-apply-lead" set:html={p.apply.lead} />
        <p class="pl-pricing" set:html={p.apply.pricing} />
      </div>
      <Form locale={locale} kind="partner" />
    </section>
  </div>
</BaseLayout>

<style>
  .pl-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(2.5rem, 2rem + 2vw, 3.5rem);
    border-block-end: 1px solid var(--lc-rule);
  }

  .pl-body {
    display: grid;
    gap: 4rem;
    padding-block: 3rem 5rem;
  }

  .pl-body :global(.pl-prose) {
    max-inline-size: 56rem;
  }

  .pl-body section + section {
    margin-block-start: 3.5rem;
  }

  /* Tailwind's preflight removes list markers; the steps are numbered, the lists bulleted. */
  .pl-body ol {
    list-style: decimal;
  }

  .pl-body ul {
    list-style: disc;
  }

  .pl-steps > li {
    margin-block-end: 1.25rem;
  }

  .pl-body .pl-steps h3 {
    margin-block: 0 0.25rem;
    font-size: 1.125rem;
  }

  .pl-steps p {
    margin-block-end: 0.25rem;
  }

  .pl-done {
    color: var(--lc-ink);
  }

  .pl-sheet {
    inline-size: 100%;
    margin-block: 0.5rem 1.5rem;
    border-collapse: collapse;
    font-size: var(--lc-text-small);
  }

  .pl-sheet caption {
    margin-block-end: 0.5rem;
    color: var(--lc-ink-faint);
    text-align: start;
  }

  .pl-sheet th,
  .pl-sheet td {
    padding: 0.625rem;
    border: 1px solid var(--lc-rule-strong);
    text-align: start;
    vertical-align: top;
  }

  .pl-sheet thead th {
    color: var(--lc-ink);
    font-weight: 600;
  }

  .pl-sheet tbody th {
    color: var(--lc-ink);
    font-weight: 500;
  }

  .pl-sheet td:empty {
    block-size: 3rem;
  }

  /* On a phone the five columns share the width and words wrap, so the sheet never scrolls. */
  @media (max-width: 640px) {
    .pl-sheet {
      table-layout: fixed;
    }

    .pl-sheet th,
    .pl-sheet td {
      padding: 0.375rem;
      overflow-wrap: break-word;
    }

    /* The two text columns take most of the width; the three columns to fill in share the rest. */
    .pl-sheet[data-worksheet] thead th:nth-child(1) {
      inline-size: 30%;
    }

    .pl-sheet[data-worksheet] thead th:nth-child(2) {
      inline-size: 34%;
    }
  }

  .pl-apply {
    display: grid;
    gap: 2.5rem;
    padding-block-start: 3rem;
    border-block-start: 1px solid var(--lc-rule-strong);
  }

  @media (min-width: 1024px) {
    .pl-apply {
      grid-template-columns: 4fr 8fr;
      gap: 4rem;
    }
  }

  .pl-apply h2 {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }

  .pl-apply-lead {
    margin-block-start: 0.75rem;
    color: var(--lc-ink-muted);
  }

  .pl-pricing {
    margin-block-start: 1.5rem;
    color: var(--lc-ink);
  }

  .pl-pricing :global(a) {
    color: var(--lc-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media print {
    .pl-apply {
      display: none;
    }
  }
</style>
