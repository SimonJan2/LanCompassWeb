---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeatureCard from "../../components/FeatureCard.astro";
import Form from "../../components/form/Form.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { getCopy } from "../../content/copy";
import { localeStaticPaths, type Locale } from "../../i18n";
import type { IconName } from "../../components/Icon.astro";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const p = copy.partners;
const getsIcons: IconName[] = ["rack", "excel", "users", "topology"];
const asksIcons: IconName[] = ["mail", "check"];
---

<BaseLayout
  locale={locale}
  page="design-partners"
  title={copy.meta["design-partners"].title}
  description={copy.meta["design-partners"].description}
>
  <section class="dp-hero grid-paper">
    <div class="container-site">
      <SectionHeading eyebrow={p.eyebrow} title={p.title} lead={p.lead} level={1} />
    </div>
  </section>

  <section class="section-tight" aria-labelledby="gets-title">
    <div class="container-site">
      <h2 id="gets-title" class="dp-h2">
        {p.getsTitle}
      </h2>
      <div class="dp-grid dp-grid-4">
        {p.gets.map((g, i) => (
          <div data-reveal>
            <FeatureCard icon={getsIcons[i] ?? "check"} title={g.title} text={g.text} />
          </div>
        ))}
      </div>
      <h2 class="dp-h2 dp-h2-spaced" id="asks-title">
        {p.asksTitle}
      </h2>
      <div class="dp-grid dp-grid-2">
        {p.asks.map((a, i) => (
          <div data-reveal>
            <FeatureCard icon={asksIcons[i] ?? "check"} title={a.title} text={a.text} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight surface-paper" aria-labelledby="steps-title">
    <div class="container-site">
      <h2 id="steps-title" class="dp-h2">
        {p.stepsTitle}
      </h2>
      <ol class="dp-steps" role="list">
        {p.steps.map((step, i) => (
          <li class="dp-step">
            <span class="dp-step-num tabular" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="dp-step-title" set:html={step.title} />
            <p class="dp-step-text" set:html={step.text} />
          </li>
        ))}
      </ol>
      <p class="dp-pricing" set:html={p.pricing} />
    </div>
  </section>

  <section class="section" id="apply" aria-labelledby="apply-title">
    <div class="container-site dp-apply">
      <div>
        <h2 id="apply-title" class="dp-h2" set:html={p.formTitle} />
        <p class="dp-apply-lead" set:html={p.formLead} />
      </div>
      <Form locale={locale} kind="partner" />
    </div>
  </section>
</BaseLayout>

<style>
  .dp-hero {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(2.5rem, 2rem + 2vw, 3.5rem);
    border-block-end: 1px solid var(--lc-hairline);
  }

  .dp-h2 {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }

  .dp-h2-spaced {
    margin-block-start: 4rem;
  }

  .dp-grid {
    display: grid;
    gap: 1rem;
    margin-block-start: 1.75rem;
  }

  @media (min-width: 700px) {
    .dp-grid-4,
    .dp-grid-2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .dp-grid-4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .dp-steps {
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 800px) {
    .dp-steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .dp-step {
    padding-block-start: 1.25rem;
    border-block-start: 2px solid var(--lc-signal);
  }

  .dp-step-num {
    color: var(--lc-signal-bright);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-text-small);
  }

  .dp-step-title {
    margin-block-start: 0.5rem;
    font-size: var(--lc-text-h3);
  }

  .dp-step-text {
    margin-block-start: 0.375rem;
    color: var(--lc-text-muted);
    font-size: var(--lc-text-small);
  }

  .dp-pricing {
    margin-block-start: 3rem;
    color: var(--lc-text);
    font-weight: 600;
  }

  .dp-apply {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .dp-apply {
      grid-template-columns: 4fr 8fr;
      gap: 4rem;
    }
  }

  .dp-apply-lead {
    margin-block-start: 0.75rem;
    color: var(--lc-text-muted);
  }
</style>
