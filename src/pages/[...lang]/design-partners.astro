---
/**
 * W7: /design-partners/ moved to /pilot/ (DECISIONS.md D-PILOT). nginx answers this URL with a
 * 301 (docker/nginx/site.conf); this small page is for any other static host: a meta refresh, a
 * canonical to /pilot/, noindex and a visible link. No script, no stylesheet; not in the sitemap
 * (astro.config.mjs) and not a page key (src/i18n/locales.ts).
 */
import type { GetStaticPaths } from "astro";
import { getCopy } from "../../content/copy";
import { absoluteUrl, localeMeta, localeStaticPaths, pagePath, type Locale } from "../../i18n";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const meta = localeMeta(locale);
const moved = getCopy(locale).moved;
const target = pagePath(locale, "pilot");
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{moved.title}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={absoluteUrl(target)} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <main>
      <p data-moved>
        {moved.text} <a href={target}>{moved.link}</a>
      </p>
    </main>
  </body>
</html>
