---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AtlasIndex from "../../components/AtlasIndex.astro";
import Button from "../../components/Button.astro";
import ComparisonRow from "../../components/ComparisonRow.astro";
import Datasheet from "../../components/Datasheet.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import FeatureCard from "../../components/FeatureCard.astro";
import Icon, { type IconName } from "../../components/Icon.astro";
import MapLegend from "../../components/MapLegend.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import StepTimeline from "../../components/StepTimeline.astro";
import TwoSheets from "../../components/TwoSheets.astro";
import VideoSlot from "../../components/VideoSlot.astro";
import BearingScale from "../../components/motifs/BearingScale.astro";
import Contours from "../../components/motifs/Contours.astro";
import Marginalia from "../../components/motifs/Marginalia.astro";
import { getCopy } from "../../content/copy";
import { absoluteUrl, localeStaticPaths, pagePath, type Locale } from "../../i18n";
import { isScreenKey } from "../../lib/screens";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const h = copy.home;
const partnersHref = `${pagePath(locale, "design-partners")}#apply`;
const productHref = pagePath(locale, "product");
const offlineIcons: IconName[] = ["offline", "eye", "lock", "key", "users", "log"];
const softwareApplication = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "LanCompass",
  applicationCategory: "NetworkingApplication",
  operatingSystem: "Linux (Docker)",
  description: copy.meta.home.description,
  url: absoluteUrl(pagePath(locale, "home")),
  inLanguage: locale,
};
const hebrewScreen = isScreenKey(h.hebrew.screen) ? h.hebrew.screen : "dashboard";
const atlasRows = h.atlas.rows.map((row) => ({
  key: row.key,
  title: row.title,
  text: row.text,
  screen: row.screen,
  href: `${productHref}#${row.section}`,
}));
---

<BaseLayout
  locale={locale}
  page="home"
  title={copy.meta.home.title}
  description={copy.meta.home.description}
  jsonLd={[softwareApplication]}
>
  <!-- Hero: light, survey paper. -->
  <section class="hero" aria-labelledby="hero-title">
    <Contours map="hero" eager />
    <div class="container-site hero-inner">
      <div class="hero-copy">
        <ul class="hero-chips" role="list">
          {h.hero.chips.map((chip) => (
            <li set:html={chip} />
          ))}
        </ul>
        <h1 id="hero-title" class="hero-title" set:html={h.hero.title} />
        <p class="hero-lead" set:html={h.hero.lead} />
        <div class="hero-ctas">
          <Button href={partnersHref}>{h.hero.primary}</Button>
          <Button href="#how-it-works" variant="secondary" arrow>
            {h.hero.secondary}
          </Button>
        </div>
      </div>
      <div class="hero-visual">
        <TwoSheets locale={locale} />
      </div>
    </div>
    <div class="container-site hero-margin">
      <Marginalia notes={h.hero.marginalia} class="hero-notes" />
    </div>
    <BearingScale mark={0} class="hero-scale" />
  </section>

  <!-- Datasheet, in place of a logo wall. -->
  <section class="datasheet-section" aria-labelledby="datasheet-title">
    <div class="container-site">
      <Datasheet
        id="datasheet-title"
        title={h.datasheet.title}
        note={h.datasheet.note}
        rows={h.datasheet.rows}
      />
    </div>
  </section>

  <!-- 045° The loop -->
  <section class="section defer-render" id="how-it-works" aria-labelledby="loop-title">
    <div class="container-site">
      <SectionHeading
        bearing={45}
        eyebrow={h.loop.eyebrow}
        title={h.loop.title}
        lead={h.loop.lead}
        id="loop-title"
      />
      <StepTimeline locale={locale} steps={h.loop.steps} figure={h.loop.figure} />
    </div>
  </section>

  <!-- 090° Atlas index -->
  <section
    class="section defer-render surface-sunk"
    id="capabilities"
    aria-labelledby="atlas-title"
  >
    <div class="container-site">
      <SectionHeading
        bearing={90}
        eyebrow={h.atlas.eyebrow}
        title={h.atlas.title}
        lead={h.atlas.lead}
        id="atlas-title"
      />
      <AtlasIndex locale={locale} rows={atlasRows} previewLabel={h.atlas.previewLabel} />
      <div class="section-more">
        <Button href={productHref} variant="tertiary">
          {h.atlas.link}
        </Button>
      </div>
    </div>
  </section>

  <!-- 135° Night band: offline -->
  <section class="section defer-render surface-night offline-band" aria-labelledby="offline-title">
    <Contours map="band" tone="night" />
    <div class="container-site">
      <SectionHeading
        bearing={135}
        eyebrow={h.offline.eyebrow}
        title={h.offline.title}
        lead={h.offline.lead}
        id="offline-title"
      />
      <ul class="offline-grid" role="list">
        {h.offline.points.map((point, i) => (
          <li class="offline-point reveal">
            <Icon name={offlineIcons[i] ?? "check"} size={20} class="offline-icon" />
            <div>
              <h3 class="offline-point-title" set:html={point.title} />
              <p class="offline-point-text" set:html={point.text} />
            </div>
          </li>
        ))}
      </ul>
      <div class="section-more">
        <Button href={pagePath(locale, "security")} variant="tertiary">
          {h.offline.link}
        </Button>
      </div>
    </div>
  </section>

  <!-- 180° Hebrew-native -->
  <section class="section defer-render" id="hebrew" aria-labelledby="hebrew-title">
    <div class="container-site">
      <SectionHeading
        bearing={180}
        eyebrow={h.hebrew.eyebrow}
        title={h.hebrew.title}
        lead={h.hebrew.lead}
        id="hebrew-title"
      />
      <ComparisonRow
        locale={locale}
        screen={hebrewScreen}
        items={[
          { screenLocale: "en", caption: h.hebrew.enCaption },
          { screenLocale: "he", caption: h.hebrew.heCaption },
        ]}
      />
    </div>
  </section>

  <!-- 225° Map legend: integrations -->
  <section
    class="section defer-render rule-top"
    id="integrations"
    aria-labelledby="integrations-title"
  >
    <div class="container-site">
      <SectionHeading
        bearing={225}
        eyebrow={h.integrations.eyebrow}
        title={h.integrations.title}
        lead={h.integrations.lead}
        id="integrations-title"
      />
      <MapLegend
        title={h.integrations.legendTitle}
        highlight={h.integrations.highlight}
        groups={[
          {
            title: h.integrations.groupIntegrations,
            symbol: "square",
            items: h.integrations.items,
          },
          { title: h.integrations.groupDrivers, symbol: "triangle", items: h.integrations.drivers },
          {
            title: h.integrations.extras.title,
            symbol: "circle",
            items: h.integrations.extras.items,
            kind: "html",
          },
        ]}
      />
    </div>
  </section>

  <!-- 270° Migration -->
  <section class="section defer-render surface-sunk" id="migration" aria-labelledby="imports-title">
    <div class="container-site">
      <SectionHeading
        bearing={270}
        eyebrow={h.imports.eyebrow}
        title={h.imports.title}
        lead={h.imports.lead}
        id="imports-title"
      />
      <div class="imports">
        {h.imports.cards.map((card, i) => (
          <div class="reveal">
            <FeatureCard icon={i === 0 ? "excel" : "import"} title={card.title} text={card.text}>
              <ul class="import-bullets" role="list">
                {card.bullets.map((b) => (
                  <li>
                    <Icon name="check" size={16} />
                    <span set:html={b} />
                  </li>
                ))}
              </ul>
            </FeatureCard>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 315° Videos -->
  <section class="section defer-render" id="videos" aria-labelledby="videos-title">
    <div class="container-site">
      <SectionHeading
        bearing={315}
        eyebrow={h.videos.eyebrow}
        title={h.videos.title}
        id="videos-title"
      />
      <div class="videos">
        {h.videos.items.map((v) => (
          <VideoSlot locale={locale} videoKey={v.key} title={v.title} />
        ))}
      </div>
    </div>
  </section>

  <!-- 360° Night band: design partners -->
  <section
    class="section defer-render surface-night partners-band"
    aria-labelledby="partners-title"
  >
    <Contours map="quiet" tone="night" />
    <div class="container-site partners-panel">
      <div class="partners-intro">
        <p class="partners-bearing" aria-hidden="true" dir="ltr">
          360°
        </p>
        <Eyebrow>{h.partners.eyebrow}</Eyebrow>
        <h2 id="partners-title" class="partners-title" set:html={h.partners.title} />
        <p class="text-lead partners-lead" set:html={h.partners.lead} />
        <Button href={partnersHref}>{h.partners.cta}</Button>
      </div>
      <div class="partners-lists">
        <div>
          <h3 class="group-title">{h.partners.getsTitle}</h3>
          <ul class="partners-list" role="list">
            {h.partners.gets.map((item) => (
              <li>
                <Icon name="check" size={18} class="partners-check" />
                <span set:html={item} />
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="group-title">{h.partners.asksTitle}</h3>
          <ul class="partners-list" role="list">
            {h.partners.asks.map((item) => (
              <li>
                <Icon name="arrow" size={18} class="partners-check" />
                <span set:html={item} />
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 4.5vw, 6.5rem) 0;
  }

  .hero-inner {
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-inner {
      grid-template-columns: 13fr 12fr;
      gap: 4rem;
    }
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }

  .hero-chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--lc-ink-muted);
    font-size: var(--lc-text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  :lang(he) .hero-chips li {
    letter-spacing: 0;
    font-size: var(--lc-text-small);
  }

  .hero-chips li::before {
    content: "";
    inline-size: 7px;
    block-size: 7px;
    border: 1px solid var(--lc-ink);
    rotate: 45deg;
  }

  .hero-title {
    font-size: clamp(2.5rem, 1.6rem + 3vw, 4rem);
    font-weight: 540;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  :lang(he) .hero-title {
    font-size: clamp(2.375rem, 1.5rem + 3.2vw, 4rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0;
  }

  .hero-lead {
    max-inline-size: 34rem;
    margin-block-start: 1.75rem;
    color: var(--lc-ink-muted);
    font-size: var(--lc-text-lead);
    line-height: 1.55;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2.5rem;
  }

  .hero-margin {
    display: none;
  }

  @media (min-width: 1024px) {
    .hero-margin {
      display: flex;
      justify-content: flex-end;
      margin-block-start: 2rem;
    }
  }

  .hero :global(.hero-scale) {
    margin-block-start: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .datasheet-section {
    padding-block: clamp(2.5rem, 2rem + 2vw, 4rem) 0;
  }

  .section-more {
    margin-block-start: 2.5rem;
  }

  /* Offline band (night) */
  .offline-band,
  .partners-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .offline-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    column-gap: 3rem;
    margin: 3.5rem 0 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--lc-ink);
  }

  .offline-point {
    display: flex;
    gap: 1rem;
    padding-block: 1.5rem;
    border-block-end: 1px solid var(--lc-rule);
  }

  .offline-point :global(.offline-icon) {
    flex: none;
    margin-block-start: 0.15rem;
    color: var(--lc-ink-muted);
  }

  .offline-point-title {
    font-size: var(--lc-text-h3);
  }

  .offline-point-text {
    margin-block-start: 0.4rem;
    color: var(--lc-ink-muted);
    font-size: var(--lc-text-small);
  }

  .offline-point-text :global(code) {
    color: var(--lc-ink);
  }

  /* Imports */
  .imports {
    display: grid;
    gap: 2.5rem;
    margin-block-start: 3rem;
  }

  @media (min-width: 800px) {
    .imports {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .import-bullets {
    display: grid;
    gap: 0.4rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--lc-font-mono);
    font-size: var(--lc-text-mono);
  }

  .import-bullets li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .import-bullets :global(svg) {
    flex: none;
    color: var(--lc-documented-line);
  }

  /* Videos */
  .videos {
    display: grid;
    gap: 2rem;
    margin-block-start: 3rem;
  }

  @media (min-width: 900px) {
    .videos {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Partners band (night) */
  .partners-panel {
    display: grid;
    gap: 3.5rem;
  }

  @media (min-width: 1024px) {
    .partners-panel {
      grid-template-columns: 6fr 5fr;
      align-items: end;
      gap: 5rem;
    }
  }

  .partners-bearing {
    inline-size: fit-content;
    min-inline-size: 4.5rem;
    margin-block-end: 1.5rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--lc-ink);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-text-mono);
    font-weight: 500;
  }

  .partners-title {
    font-size: var(--lc-text-h2);
  }

  .partners-lead {
    margin-block: 1.25rem 2.25rem;
  }

  .partners-lists {
    display: grid;
    gap: 2.5rem;
  }

  .group-title {
    margin-block-end: 0.875rem;
    padding-block-end: 0.5rem;
    border-block-end: 1px solid var(--lc-rule);
    color: var(--lc-ink-muted);
    font-size: var(--lc-text-small);
    font-weight: 500;
    letter-spacing: 0;
  }

  .partners-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .partners-list li {
    display: flex;
    gap: 0.625rem;
  }

  .partners-list :global(.partners-check) {
    flex: none;
    margin-block-start: 0.25rem;
    color: var(--lc-ink-muted);
  }
</style>
