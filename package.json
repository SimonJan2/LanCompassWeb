{
  "name": "lancompass-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node scripts/build-test.mjs",
    "test": "playwright test",
    "lhci": "node scripts/lhci.mjs",
    "links": "linkinator dist --recurse --skip \"^mailto:\" --skip \"^https://\" --skip \"localhost:4321\"",
    "capture": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.3",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-hebrew": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "linkinator": "8.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3"
  }
}
